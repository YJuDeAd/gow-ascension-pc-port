     uint32_t lsa = (uint32_t)(ls - ctx->ls);
@@ -2036,45 +2238,7 @@ void spu_overlay_note_get(spu_context* ctx, uint32_t ea, const uint8_t* ls, uint
                              : (o->src_ea == ea);
