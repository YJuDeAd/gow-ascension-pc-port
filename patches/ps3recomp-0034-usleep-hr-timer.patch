From 3a84f52de5b8bc6b78ce7754668534cb46a77d07 Mon Sep 17 00:00:00 2001
From: Arnaldo Lima <arnaldolimaof@gmail.com>
Date: Sun, 18 Oct 2026 07:46:01 -0300
Subject: [PATCH] usleep from 200 us sleeps on a high-resolution timer;
 LD_DRAW_DUMP_SKIP

from gow-ascension-pc@676eefe

- sys_timer_usleep: waits of SYS_USLEEP_SPIN_MAX_US (default 200) and more
  sleep on a per-thread CREATE_WAITABLE_TIMER_HIGH_RESOLUTION timer instead
  of spinning to a QPC deadline. God of War: Ascension polls with 800 us
  sleeps on one thread, which held a core at 100%: the main menu goes from
  54% to 48% of a 16-thread CPU at the same frame rate. Shorter waits still
  spin.
- LD_DRAW_DUMP_SKIP=<n>: skip the first n gated frames, so the dumped frame
  starts at its first draw.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/video/rsx_live_draw.c   | 11 +++++++----
 runtime/syscalls/sys_timer.c | 26 ++++++++++++++++++++++++++
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/libs/video/rsx_live_draw.c b/libs/video/rsx_live_draw.c
index d3b6a17..7c28524 100644
--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -6942,11 +6942,14 @@ static void live_draw_csv_emit(u32 prim, u32 n_tri, const char* outcome)
     /* LD_DRAW_DUMP=<dir> [LD_DRAW_DUMP_EVERY=k, default 10]: in the first
      * gated frame, read back each k-th draw's target BEFORE it is recorded,
      * named by frame-relative index -- bisects which draw changes a surface. */
-    { static const char* dir = (const char*)-1; static u32 every, frame = ~0u, idx, dumped_frame = ~0u;
+    /* LD_DRAW_DUMP_SKIP=<n>: pass over the first n gated frames, so the dumped
+     * one starts at its first draw instead of wherever the gate opened. */
+    { static const char* dir = (const char*)-1; static u32 every, frame = ~0u, idx, dumped_frame = ~0u, skip;
       if (dir == (const char*)-1) { dir = getenv("LD_DRAW_DUMP");
-          const char* e = getenv("LD_DRAW_DUMP_EVERY"); every = e ? (u32)atoi(e) : 10; if (!every) every = 10; }
-      if (frame != g_ld_frames) { frame = g_ld_frames; idx = 0; }
-      if (dir && target < g.n_surfaces && (dumped_frame == ~0u || dumped_frame == frame) &&
+          const char* e = getenv("LD_DRAW_DUMP_EVERY"); every = e ? (u32)atoi(e) : 10; if (!every) every = 10;
+          const char* k = getenv("LD_DRAW_DUMP_SKIP"); skip = k ? (u32)atoi(k) : 0; }
+      if (frame != g_ld_frames) { if (frame != ~0u && skip) skip--; frame = g_ld_frames; idx = 0; }
+      if (dir && !skip && target < g.n_surfaces && (dumped_frame == ~0u || dumped_frame == frame) &&
           (idx % every) == 0) {
           dumped_frame = frame;
           char path[MAX_PATH * 2];
diff --git a/runtime/syscalls/sys_timer.c b/runtime/syscalls/sys_timer.c
index 78b3e38..9bab8d2 100644
--- a/runtime/syscalls/sys_timer.c
+++ b/runtime/syscalls/sys_timer.c
@@ -217,6 +217,32 @@ int64_t sys_timer_usleep(ppu_context* ctx)
         ppu_log_host_chain("usleep1ms"); } }
 
 #ifdef _WIN32
+    /* From SYS_USLEEP_SPIN_MAX_US (default 200) up, sleep on a per-thread
+     * high-resolution waitable timer (Windows 10 1803+): it wakes within a
+     * fraction of a millisecond without spinning. The spin below was meant for
+     * microsecond waits; God of War: Ascension polls with 800 us sleeps on one
+     * thread, which kept a whole core busy doing nothing. */
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+    static long s_spin_max = -1;
+    if (s_spin_max < 0) { const char* e = getenv("SYS_USLEEP_SPIN_MAX_US"); s_spin_max = e ? atol(e) : 200; }
+    static __declspec(thread) HANDLE t_hr_timer;
+    static __declspec(thread) int t_hr_failed;
+    if (usec >= (uint64_t)s_spin_max && usec > 0 && !t_hr_failed) {
+        if (!t_hr_timer) {
+            t_hr_timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+            if (!t_hr_timer) t_hr_failed = 1;
+        }
+        if (t_hr_timer) {
+            LARGE_INTEGER due;
+            due.QuadPart = -((LONGLONG)usec * 10);   /* 100 ns units, negative = relative */
+            if (SetWaitableTimer(t_hr_timer, &due, 0, NULL, NULL, FALSE)) {
+                WaitForSingleObject(t_hr_timer, INFINITE);
+                return CELL_OK;
+            }
+        }
+    }
     /* Use high-resolution sleep via waitable timer for better precision */
     if (usec >= 1000) {
         HANDLE timer = CreateWaitableTimerW(NULL, TRUE, NULL);
-- 
