+/* Ensure parent directories exist before creating files */
+static void ensure_parent_dirs(const char* path)
+{
+    char tmp[1100];
+    strncpy(tmp, path, sizeof(tmp) - 1);
+    tmp[sizeof(tmp) - 1] = '\0';
+    char* last_sep = nullptr;
+    for (char* p = tmp; *p; p++) {
+        if (*p == '/' || *p == '\\') last_sep = p;
+    }
+    if (!last_sep) return;
+    *last_sep = '\0';
+
+    for (char* p = tmp; *p; p++) {
+        if (*p == '/' || *p == '\\') {
+            char saved = *p;
+            *p = '\0';
+            if (strlen(tmp) > 0 && tmp[strlen(tmp) - 1] != ':') {
+#ifdef _WIN32
+                _mkdir(tmp);
+#else
+                mkdir(tmp, 0755);
+#endif
+            }
+            *p = saved;
+        }
+    }
+    if (strlen(tmp) > 0 && tmp[strlen(tmp) - 1] != ':') {
+#ifdef _WIN32
+        _mkdir(tmp);
+#else
+        mkdir(tmp, 0755);
+#endif
+    }
