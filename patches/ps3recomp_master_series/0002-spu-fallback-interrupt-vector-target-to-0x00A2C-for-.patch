+extern "C" void ppu_hle_dump_summary_table(void)
+{
+    AcquireSRWLockExclusive(&s_hle_rec_lock);
+    const uint32_t targets[2] = {1u, 12u};
+    for (uint32_t target_tid : targets) {
+        int indices[512];
+        int count = 0;
+        for (int i = 0; i < s_hle_record_count; i++) {
+            if (s_hle_records[i].tid == target_tid) {
+                indices[count++] = i;
+            }
+        }
+        for (int i = 0; i < count - 1; i++) {
+            for (int j = i + 1; j < count; j++) {
+                if (s_hle_records[indices[j]].count > s_hle_records[indices[i]].count) {
+                    int tmp = indices[i];
+                    indices[i] = indices[j];
+                    indices[j] = tmp;
+                }
+            }
+        }
+        fprintf(stderr, "\n=== [HLE-CALL-TABLE] tid=%u Distinct HLE Calls (%d total distinct) ===\n", target_tid, count);
+        fprintf(stderr, "%-4s | %-10s | %-32s | %-8s | %-6s | %-42s | %-18s\n",
+                "Rank", "NID", "Name", "Count", "Type", "Args (r3, r4, r5, r6)", "Return");
+        fprintf(stderr, "------------------------------------------------------------------------------------------------------------------------\n");
+        for (int i = 0; i < count; i++) {
+            HleSummaryRecord& rec = s_hle_records[indices[i]];
+            char args_str[64];
+            snprintf(args_str, sizeof(args_str), "(0x%08X, 0x%08X, 0x%08X, 0x%08X)",
+                     rec.args[0], rec.args[1], rec.args[2], rec.args[3]);
+            char ret_str[32];
+            snprintf(ret_str, sizeof(ret_str), "0x%llX", (unsigned long long)rec.ret);
+            fprintf(stderr, "#%-3d | 0x%08X | %-32s | %-8llu | %-6s | %-42s | %-18s\n",
+                    i + 1, rec.nid, rec.name, (unsigned long long)rec.count,
+                    rec.is_stub ? "STUB" : "REAL", args_str, ret_str);
+        }
+        fprintf(stderr, "========================================================================================================================\n\n");
+    }
+    ReleaseSRWLockExclusive(&s_hle_rec_lock);
+    fflush(stderr);
+}
