+static void check_target_hle_inspect(uint32_t tid, uint32_t nid, const char* name,
+                                     const uint32_t args[4], uint64_t ret, int is_stub)
+{
+    if (!name) return;
+    static const char* prefixes[] = {
+        "cellPad", "cellMsgDialog", "cellSysutil", "cellSail", "cellPamf",
+        "cellVdec", "cellDmux", "cellSaveData", "cellGameContent"
+    };
+    bool match = false;
+    for (const char* p : prefixes) {
+        if (strncmp(name, p, strlen(p)) == 0) { match = true; break; }
+    }
+    if (!match) return;
+
+    static unsigned long s_target_log_count = 0;
+    if (s_target_log_count++ < 200 || (s_target_log_count % 500) == 0) {
+        fprintf(stderr, "[TARGET-HLE #%lu] tid=%u %s (0x%08X) args=(0x%08X, 0x%08X, 0x%08X, 0x%08X) -> ret=0x%llX (stub=%d)\n",
+                s_target_log_count, tid, name, nid, args[0], args[1], args[2], args[3], (unsigned long long)ret, is_stub);
+    }
+
+    if (strcmp(name, "cellPadGetInfo2") == 0 && args[0] && vm_base) {
+        uint32_t ptr = args[0];
+        uint32_t max_c = vm_read32(ptr + 0x00);
+        uint32_t now_c = vm_read32(ptr + 0x04);
+        uint32_t status0 = vm_read32(ptr + 0x0C);
+        uint32_t setting0 = vm_read32(ptr + 0x28);
+        static int _pi = 0;
+        if (_pi++ < 10) {
+            fprintf(stderr, "  [PAD-INFO2] ptr=0x%08X: max_connect=%u now_connect=%u port0_status=0x%X setting0=0x%X\n",
+                    ptr, max_c, now_c, status0, setting0);
+        }
+    } else if (strcmp(name, "cellPadGetData") == 0 && args[1] && vm_base) {
+        uint32_t port = args[0];
+        uint32_t ptr = args[1];
+        int32_t len = (int32_t)vm_read32(ptr + 0x00);
+        uint16_t b0 = vm_read16(ptr + 0x04);
+        uint16_t b1 = vm_read16(ptr + 0x06);
+        uint16_t dig1 = vm_read16(ptr + 0x08);
+        uint16_t dig2 = vm_read16(ptr + 0x0A);
+        static int _pd = 0;
+        if (_pd++ < 15 || len > 0) {
+            fprintf(stderr, "  [PAD-DATA] port=%u ptr=0x%08X: len=%d b0=0x%04X b1=0x%04X dig1=0x%04X dig2=0x%04X\n",
+                    port, ptr, len, b0, b1, dig1, dig2);
+        }
+    } else if (strcmp(name, "cellPadSetActDirect") == 0) {
+        static int _pa = 0;
+        if (_pa++ < 10) {
+            fprintf(stderr, "  [PAD-ACT] port=%u act_param=0x%08X\n", args[0], args[1]);
+        }
+    }
+}
