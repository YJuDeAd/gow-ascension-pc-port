+/* Replace an 8-bit colour surface's GPU contents with what guest memory holds
+ * at its offset (A R G B bytes, pitch w*4) -- the RSX-side image another
+ * emulator left there. rrc_replay uses it to give one draw exactly the
+ * inputs RPCS3 had. Returns 0 on success. */
+int rsx_live_draw_debug_surface_from_guest(u32 location, u32 offset)
+{
+    if (!g.ready) return -1;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        surface_t* s = &g.surfaces[i];
+        if (s->location != location || s->offset != offset || !s->tex) continue;
+        if (s->fmt != DXGI_FORMAT_R8G8B8A8_UNORM) return -1;
+        const u8* src = guest_ptr(location, offset, s->w * s->h * 4u);
+        if (!src) return -1;
+        const u32 upitch = (s->w * 4u + 255u) & ~255u;
+        ld_flush(LD_FLUSH_READBACK);               /* an empty upload ring */
+        if ((u64)upitch * s->h > UPLOAD_SIZE) return -1;
+        for (u32 y = 0; y < s->h; y++) {
+            u8* o = g.upload_mapped + (size_t)y * upitch;
+            const u8* q = src + (size_t)y * s->w * 4u;
+            for (u32 x = 0; x < s->w; x++) {       /* A R G B -> R G B A */
+                o[x * 4] = q[x * 4 + 1]; o[x * 4 + 1] = q[x * 4 + 2];
+                o[x * 4 + 2] = q[x * 4 + 3]; o[x * 4 + 3] = q[x * 4];
+            }
+        }
+        g.upload_used = upitch * s->h;
+        D3D12_RESOURCE_BARRIER b = {0};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = s->tex;
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+        D3D12_TEXTURE_COPY_LOCATION sl = {0}, dl = {0};
+        sl.pResource = g.upload; sl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        sl.PlacedFootprint.Offset = 0;
+        sl.PlacedFootprint.Footprint.Format = s->fmt;
+        sl.PlacedFootprint.Footprint.Width = s->w;
+        sl.PlacedFootprint.Footprint.Height = s->h;
+        sl.PlacedFootprint.Footprint.Depth = 1;
+        sl.PlacedFootprint.Footprint.RowPitch = upitch;
+        dl.pResource = s->tex; dl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        g.list->lpVtbl->CopyTextureRegion(g.list, &dl, 0, 0, 0, &sl, NULL);
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+        ld_flush(LD_FLUSH_READBACK);
+        fprintf(stderr, "[live-replay-boundary] surface %u:%08X loaded from guest memory\n", location, offset);
+        return 0;
+    }
+    return 1;
+}
