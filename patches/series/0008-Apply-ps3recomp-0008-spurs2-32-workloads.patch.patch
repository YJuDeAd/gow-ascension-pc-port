+/* Instance fields of a workload: the first 16 and the CellSpurs2 second set
+ * (readyCount2 shares the idle-SPU-count bytes, as in libspurs). The second
+ * set's contention is kept host-side. */
+static u32 wkl_ready_off(u32 wid) { return wid < 16 ? SPURS_WKL_READY1 + wid : SPURS_WKL_IDLE2 + (wid - 16); }
+static u32 wkl_state_off(u32 wid) { return wid < 16 ? SPURS_WKL_STATE1 + wid : SPURS_WKL_STATE2 + (wid - 16); }
+static u32 wkl_info_off(u32 wid)  { return wid < 16 ? SPURS_WKL_INFO1 + wid * SPURS_WKL_INFO_SZ
+                                                    : SPURS_WKL_INFO2 + (wid - 16) * SPURS_WKL_INFO_SZ; }
+static u32 wkl_signal_off(u32 wid) { return wid < 16 ? SPURS_WKL_SIGNAL1 : SPURS_WKL_SIGNAL2; }
+static int wkl_signalled(u32 ea, u32 wid)
+{ return (vm_read16(ea + wkl_signal_off(wid)) & (0x8000u >> (wid & 15))) != 0; }
+static void wkl_signal_clear(u32 ea, u32 wid)
+{
+    u32 off = wkl_signal_off(wid);
+    ef_w16(ea + off, (u16)(vm_read16(ea + off) & ~(0x8000u >> (wid & 15))));
+}
+static u32 wkl_maxcont(u32 ea, u32 wid)
+{ return wid < 16 ? vm_read8(ea + SPURS_WKL_MAXCONT + wid) : s_workloads[wid].maxContention; }
+static void wkl_curcont_set(u32 ea, u32 wid, u8 v)
+{ if (wid < 16) vm_base[ea + SPURS_WKL_CURCONT + wid] = v; }
