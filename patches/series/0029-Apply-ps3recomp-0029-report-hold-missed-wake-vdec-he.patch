+                  if (!gcm_is_park_site(s_fifo_getoff))
+                      s_park_sites[s_park_sites_n++ % GCM_PARK_SITES] = s_fifo_getoff;
+                  if (s_park_sites_n > GCM_PARK_SITES) s_park_sites_n = GCM_PARK_SITES;
