+             * method and the next pass re-reads it. Off by default. */
+            if (subch == 0 && (type == 0 ? (method <= 0x1800u && 0x1800u < method + count * 4u)
+                                         : method == 0x1800u)) {
+                static long rhold = -1; static unsigned long long rheld_since; static unsigned long rheld_n;
+                if (rhold < 0) { const char* e = getenv("GCM_REPORT_SPU_HOLD_MS"); rhold = e ? atol(e) : 0; }
+                extern long spu_taskset_tasks_running(void) __attribute__((weak));
+                if (rhold > 0) {
+                    /* QPC, not ps3_ms_now: GetTickCount64 steps by ~15.6 ms,
+                     * which is a frame. */
+                    const unsigned long long now = ps3_qpc_us();
+                    if (spu_taskset_tasks_running && spu_taskset_tasks_running() > 0) {
+                        if (!rheld_since) rheld_since = now;
+                        if (now - rheld_since < (unsigned long long)rhold * 1000ull) { why = "report-hold"; break; }
+                    }
+                    { static int lg = -1; if (lg < 0) lg = getenv("GCM_HOLD_LOG") ? 1 : 0;
+                      if (lg && rheld_since)
+                        fprintf(stderr, "[report-hold] t=%lluus #%lu get=0x%X held=%lluus\n",
+                                now, ++rheld_n, s_fifo_getoff, now - rheld_since); }
+                    rheld_since = 0;
+                }
+            }
             for (u32 i = 0; i < count; i++) {
                 u32 dea = gcm_io2ea(s_fifo_getoff + 4 + i * 4);
                 if (!dea) break;
@@ -2515,10 +2572,10 @@ static void gcm_rsx_process_fifo_unlocked(void)
      * GPU waits there by design until the label is released. Ascension's
      * frame waits on a label its SPU post-process tasks write when they are
      * done with the frame; following put dropped the frame mid-wait. Nor is
-     * a patched park held for SPU work (GCM_PARK_SPU_HOLD_MS), which bounds
-     * its own wait. */
+     * a patched park or a report held for SPU work (GCM_PARK_SPU_HOLD_MS,
+     * GCM_REPORT_SPU_HOLD_MS), each of which bounds its own wait. */
     { static u32 last = 0xFFFFFFFFu; static int stuck = 0;
-      if (why && (strcmp(why, "parked") == 0 || strcmp(why, "sema-acquire") == 0 || strcmp(why, "flip-pace") == 0 || strcmp(why, "spu-hold") == 0)) { stuck = 0; last = s_fifo_getoff; }
+      if (why && (strcmp(why, "parked") == 0 || strcmp(why, "sema-acquire") == 0 || strcmp(why, "flip-pace") == 0 || strcmp(why, "spu-hold") == 0 || strcmp(why, "report-hold") == 0)) { stuck = 0; last = s_fifo_getoff; }
       else if (s_fifo_getoff == last && s_fifo_getoff != put) {
           if (++stuck >= 8) { gcm_fifo_dump_around(s_fifo_getoff);
                              gcm_fifo_resync_why("stuck-get", &s_fifo_getoff, put); stuck = 0; }
diff --git a/runtime/spu/spu_workload.c b/runtime/spu/spu_workload.c
index 1e434f4..47be951 100644
--- a/runtime/spu/spu_workload.c
+++ b/runtime/spu/spu_workload.c
@@ -1233,19 +1233,56 @@ int spu_workload_current_task(void) { return s_cur_task; }
  * RSX, which runs a frame in no time, from overtaking that work where a real
  * RSX would still be drawing (GCM_PARK_SPU_HOLD_MS, cellGcmSys.c). */
 static volatile long s_tasks_out_of_wait;
+/* The last running task back in its wait: a GET_REPORT held for the tasks
+ * (GCM_REPORT_SPU_HOLD_MS) can go now, so wake the walker instead of letting
+ * it find out at its next poll. */
+extern void cellGcm_fifo_kick(void);
+static void spu_task_back_in_wait(void)
+{
+    if (__atomic_sub_fetch(&s_tasks_out_of_wait, 1, __ATOMIC_ACQ_REL) == 0)
+        cellGcm_fifo_kick();
+}
 static _Thread_local int s_task_out;
-long spu_taskset_tasks_running(void) { return __atomic_load_n(&s_tasks_out_of_wait, __ATOMIC_ACQUIRE); }
+/* Also a task still parked whose signal is already set: it has work and is
+ * about to run. Right after RsxSync signals the five post-process tasks there
+ * is an instant when all of them are signalled but none has woken; counting
+ * only woken tasks let the GPU hold go there, frame 2's reports landed before
+ * round 1 had started, and God of War: Ascension stopped at the end of
+ * loading (deterministically once its SPU jobs ran lifted). */
+long spu_taskset_tasks_running(void)
+{
+    const long n = __atomic_load_n(&s_tasks_out_of_wait, __ATOMIC_ACQUIRE);
+    if (n) return n;
+    for (int i = 0; i < SPU_PARKED_MAX; i++) {
+        const uint64_t k = s_parked[i];
+        if (k && spurs_bitset_test((uint32_t)(k >> 32) + CSTS_SIGNALLED, (uint32_t)(k & 0xFFFFFFFFu) - 1u))
+            return 1;
+    }
+    return 0;
+}
 /* A task that ends while out of a wait is no longer running. */
 void spu_taskset_task_ended(void)
 {
-    if (s_task_out) { s_task_out = 0; __atomic_fetch_sub(&s_tasks_out_of_wait, 1, __ATOMIC_ACQ_REL); }
+    if (s_task_out) { s_task_out = 0; spu_task_back_in_wait(); }
+}
+
+/* A wait that timed out with its bit already set: the commit that set it did
+ * not wake the waiter. Counted, and logged with SPU_WAITSIG_MISSLOG. */
+static volatile long s_waitsig_missed;
+static void spu_waitsig_missed(uint32_t taskId, uint32_t taskset_ea)
+{
+    const long n = __atomic_add_fetch(&s_waitsig_missed, 1, __ATOMIC_RELAXED);
+    static int lg = -1; if (lg < 0) lg = getenv("SPU_WAITSIG_MISSLOG") ? 1 : 0;
+    if (lg) { extern unsigned long long ps3_qpc_us(void);
+        fprintf(stderr, "[missed-wake] t=%lluus #%ld task=%u taskset=0x%08X\n",
+                ps3_qpc_us(), n, taskId, taskset_ea); }
 }
 
