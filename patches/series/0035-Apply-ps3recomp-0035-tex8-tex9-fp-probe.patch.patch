From 05140bf70ec9d7076d2e9e2f6e1bcccd3c31af86 Mon Sep 17 00:00:00 2001
From: YJuDeAd <robinrashi@gmail.com>
Date: Sun, 25 Oct 2026 04:47:11 +0530
Subject: [PATCH 35/47] Apply ps3recomp-0035-tex8-tex9-fp-probe.patch

---
 libs/video/rsx_live_draw.c | 51 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/libs/video/rsx_live_draw.c b/libs/video/rsx_live_draw.c
index 17b6805..475dfff 100644
--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -5641,6 +5641,36 @@ static ID3D12PipelineState* get_pso(
       char* c0 = fc && vi > 0 && (!fk || fk == live_legacy_pso_key())
                  ? strstr(vs_hlsl, "Out.col0 = o[1];") : NULL;
       if (c0) memcpy(c0, "Out.col0=1+0*_p;", 16); }   /* same length, in place */
+    /* LD_FP_PROBE=<pso key>:<hlsl expr>: the PSO with that key (as the draw CSV
+     * and LD_HLSL_DUMP print it) outputs float4((expr).xyz, 1) on its first
+     * colour target instead, e.g. "a3cc99760cc9dd86:h[1].wwww" to see a
+     * material's mask on screen. Registers hold their last value at the end of
+     * the program, so a sample is visible if nothing wrote that register after. */
+    /* LD_FP_PROBE=<text>|<expr> matches by content instead: every pixel
+     * program containing <text> (keys change from run to run). */
+    { static const char* pe = (const char*)-1; static unsigned long long pk; static char pexpr[256], psub[256];
+      if (pe == (const char*)-1) {
+          pe = getenv("LD_FP_PROBE");
+          const char* bar = pe ? strchr(pe, '|') : NULL;
+          if (bar) { snprintf(psub, sizeof psub, "%.*s", (int)(bar - pe), pe); snprintf(pexpr, sizeof pexpr, "%s", bar + 1); }
+          else if (pe) { pk = _strtoui64(pe, 0, 16); const char* c = strchr(pe, ':');
+                         snprintf(pexpr, sizeof pexpr, "%s", c ? c + 1 : "h[0]"); }
+      }
+      if (pe && fi > 0 && (psub[0] ? strstr(ps_hlsl, psub) != NULL : pk == live_legacy_pso_key())) {
+          pk = live_legacy_pso_key();
+          const char* marks[2] = { "float4 _o0 = ", "float4 _o = " };
+          for (int mi = 0; mi < 2; mi++) {
+              char* at = strstr(ps_hlsl, marks[mi]);
+              char* semi = at ? strchr(at, ';') : NULL;
+              if (!semi) continue;
+              static char tail[256 * 1024];
+              snprintf(tail, sizeof tail, "%s", semi);
+              snprintf(at, sizeof(ps_hlsl) - (size_t)(at - ps_hlsl), "%sfloat4((%s).xyz, 1)%s",
+                       marks[mi], pexpr, tail);
+              fprintf(stderr, "[fp-probe] pso %016llx output 0 = %s\n", pk, pexpr);
+              break;
+          }
+      } }
     /* LD_HLSL_DUMP=<dir>: files named by the PSO key the draw CSV prints. */
     { static const char* hd = (const char*)-1;
       if (hd == (const char*)-1) hd = getenv("LD_HLSL_DUMP");
@@ -7427,6 +7457,27 @@ static void live_draw_csv_emit(u32 prim, u32 n_tri, const char* outcome)
             fprintf(file, "%u:%u:%X:%02X:%ux%u ", u, t.location, t.offset,
                     t.format & 0xFF, t.width, t.height);
     }
+    /* LD_ATTR_DBG=1: each active vertex array, type/size/stride/location:offset
+     * and the first 12 bytes at that offset, to see a stream that reads as
+     * zeros (a buffer an SPU job fills, or a wrong offset). */
+    if (LD_DIAG_ENABLED("LD_ATTR_DBG"))
+        for (u32 a = 0; a < 16; a++) {
+            if (!((active_attr_mask >> a) & 1u)) continue;
+            rsx_dsp_vertex_attr va; rsx_dsp_get_vertex_attr(&g.rsx, a, &va);
+            const u8* p = guest_ptr(va.location, va.offset, 16);
+            fprintf(file, "va%u=%u/%u/%u/%u:%X", a, va.type, va.size, va.stride, va.location, va.offset);
+            if (p) { fputc('[', file); for (int b = 0; b < 12; b++) fprintf(file, "%02X", p[b]); fputc(']', file); }
+            /* how many of the first 256 vertices hold anything but zeros */
+            if (va.stride) {
+                const u32 bytes = va.type == 2 ? 4u : (va.type == 4 || va.type == 7) ? 1u : va.type == 6 ? 4u : 2u;
+                const u32 elem = va.type == 6 ? 4u : bytes * (va.size ? va.size : 1u);
+                const u8* q = guest_ptr(va.location, va.offset, va.stride * 256u);
+                if (q) { u32 nz = 0; for (u32 v = 0; v < 256u; v++) { u32 any = 0;
+                         for (u32 b = 0; b < elem; b++) any |= q[v * va.stride + b]; nz += any != 0; }
+                         fprintf(file, "{nz%u}", nz); }
+            }
+            fputc(' ', file);
+        }
     if (rs.blend_enable)
         fprintf(file, "bf=%X/%X/%X/%X eq=%X/%X ", rs.sf_rgb, rs.df_rgb, rs.sf_a, rs.df_a,
                 rs.eq_rgb, rs.eq_a);
-- 
