Subject: [PATCH 12/47] Apply ps3recomp-0012-spu-evlog.patch

---
 runtime/spu/spu_channels.c | 26 +++++++++++++++++++++++++-
 runtime/spu/spu_dma.h      |  2 ++
 runtime/spu/spu_drain.c    |  2 ++
 runtime/spu/spurs_policy.c |  4 ++++
 4 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index e0103f1..53f8277 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -450,6 +450,24 @@ void spu_dmaring_dump(void)
     }
 }
 
+/* SPU_EVLOG=1 [SPU_EVLOG_WID=<wid>]: the interrupt path of a policy module
+ * in order -- stall-notify raised, interrupt taken, stall acknowledged, run
+ * begun and ended -- for one workload (wklCurrentId, LS 0x1DC) or all. */
+void spu_evlog(const spu_context* ctx, const char* what, uint32_t a, uint32_t b)
+{
+    static int s_on = -1; static int s_wid = -1;
+    if (s_on < 0) { s_on = getenv("SPU_EVLOG") ? 1 : 0;
+                    const char* w = getenv("SPU_EVLOG_WID"); s_wid = w ? atoi(w) : -1; }
+    if (!s_on || !ctx->policy_mode) return;
+    const unsigned wid = ctx->ls[0x1DF];
+    if (s_wid >= 0 && wid != (unsigned)s_wid) return;
+    static volatile LONG n;
+    if (InterlockedIncrement(&n) > 20000) return;
+    fprintf(stderr, "[evlog] t=%llu wid=%u spu=%u pc=0x%05X %s 0x%X 0x%X evmask=0x%X evstat=0x%X ie=%u parked=0x%X\n",
+            (unsigned long long)GetTickCount64(), wid, ctx->ls[0x1CB], (unsigned)(ctx->pc & SPU_LS_MASK),
+            what, a, b, ctx->event_mask, ctx->event_status, ctx->int_enable, ctx->list_stall_mask);
+}
+
 /* Returns 1 if `cmd` is an atomic line op and was handled here, else 0. */
 static int spu_mfc_atomic(spu_context* ctx, uint32_t cmd)
 {
@@ -904,6 +922,10 @@ void spu_wrch(spu_context* ctx, uint32_t channel, u128 value)
         if (channel == MFC_Cmd && spu_mfc_atomic(ctx, v))
             return;
         mfc_channel_write(mfc_for(ctx), ctx, channel, v);
+        /* SPU_EVLOG=1: MFC_WrTagMask / MFC_WrTagUpdate writes under a policy
+         * module, with the event mask they meet (first 400). */
+        if (channel == MFC_WrTagUpdate || channel == MFC_WrTagMask || channel == MFC_WrListStallAck)
+            spu_evlog(ctx, channel == MFC_WrTagUpdate ? "TagUpdate" : channel == MFC_WrTagMask ? "TagMask" : "StallAck", v, 0);
         /* MFC tag-status-update EVENT producer (channel-stall milestone). Our
          * DMA completes synchronously, so the instant the program arms tag
          * notification (MFC_WrTagUpdate with a non-zero mode = any/all), the
@@ -959,7 +981,9 @@ void spu_wrch(spu_context* ctx, uint32_t channel, u128 value)
         break;
     case SPU_WrDec:          ctx->decrementer = v;
                              ctx->dec_base_ns = spu_host_ns();              break;
-    case SPU_WrEventMask:    ctx->event_mask = v;                           break; /* WrEventMask */
+    case SPU_WrEventMask:
+        spu_evlog(ctx, "EventMask", v, 0);
+                             ctx->event_mask = v;                           break; /* WrEventMask */
     case SPU_WrEventAck:
         /* Under the lock-line lock, because every producer of the LR bit sets
          * it under that lock: the PPU coherent store, and a peer SPU's PUTLLC,
diff --git a/runtime/spu/spu_dma.h b/runtime/spu/spu_dma.h
index 8d74a0a..e6936db 100644
--- a/runtime/spu/spu_dma.h
+++ b/runtime/spu/spu_dma.h
@@ -796,6 +796,8 @@ static inline int mfc_run_list(spu_context* spu, uint32_t elem_lsa,
             spu->list_stall_mask |= (1u << t);  /* this tag now has a parked list */
             spu->list_stall_stat |= (1u << t);  /* accumulate into the notify mask */
             spu->event_status    |= 0x2u;       /* SPU_EVENT_SN stall-and-notify */
+            { extern void spu_evlog(const spu_context*, const char*, uint32_t, uint32_t);
+              spu_evlog(spu, "SN-raise tag/ea", t, (uint32_t)ea_base); }
             /* Real MFC runs a queued list asynchronously, so the notify lands
              * AFTER the arming code finishes. We run it inline here, so hold the
              * resulting interrupt off for a few drain ticks -- otherwise the WWS
diff --git a/runtime/spu/spu_drain.c b/runtime/spu/spu_drain.c
index fc3cea1..3349adb 100644
--- a/runtime/spu/spu_drain.c
+++ b/runtime/spu/spu_drain.c
@@ -308,6 +308,8 @@ void (*spu_take_interrupt(spu_context* ctx,
     }
     ctx->srr0 = ctx->pc;             /* resume point for iret */
     ctx->int_enable = 0;
+    { extern void spu_evlog(const spu_context*, const char*, uint32_t, uint32_t);
+      spu_evlog(ctx, "INT-take srr0/target", ctx->srr0 & SPU_LS_MASK, target & SPU_LS_MASK); }
     spu_irq_regs_save(ctx);          /* hardware contract: handler preserves regs */
     { static int s_it = -1; if (s_it < 0) s_it = getenv("SPU_IRQTRACE") ? 1 : 0;
       if (s_it) { static int _n = 0; if (PS3_LOG_FIRST(_n, 200))
diff --git a/runtime/spu/spurs_policy.c b/runtime/spu/spurs_policy.c
index a7f7a48..8bf1d34 100644
--- a/runtime/spu/spurs_policy.c
+++ b/runtime/spu/spurs_policy.c
@@ -312,6 +312,8 @@ int spu_run_policy_module(spu_lifted_entry_fn entry, int image_id,
 
     g_spurs_pm_polls  = 0;
