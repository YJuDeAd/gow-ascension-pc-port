diff --git a/runtime/spu/spu_drain.c b/runtime/spu/spu_drain.c
index 0cadb46b..61f36b6e 100644
--- a/runtime/spu/spu_drain.c
+++ b/runtime/spu/spu_drain.c
@@ -445,12 +445,13 @@ void (*spu_take_interrupt(spu_context* ctx,
     } else if (op9 == 0x064) {       /* br i16 (relative to LS 0) */
         target = (((w >> 7) & 0xFFFF) << 2) & SPU_LS_MASK;
     } else {
-        static int _w = 0;
-        if (PS3_LOG_FIRST(_w, 4))
-            fprintf(stderr, "[spu-int] pending (st=0x%X mask=0x%X) but LS0 word "
-                    "0x%08X is no branch -- not taken\n",
-                    ctx->event_status, ctx->event_mask, w);
-        return tf;
+        /* Standard Cell SPU architectural interrupt vector is at offset 0x40.
+         * WWS Job Manager and other SPU runtimes place the interrupt handler directly at 0x40. */
+        target = 0x00040u;
+    }
+    extern uint64_t g_preempt_h0040_runs[8];
+    if (ctx && ctx->spu_id < 8) {
+        g_preempt_h0040_runs[ctx->spu_id]++;
     }
     ctx->srr0 = ctx->pc;             /* resume point for iret */
     ctx->int_enable = 0;
@@ -547,6 +548,26 @@ SPU_THREAD_LOCAL int g_spu_drain_anyret;
  * plain r0 drain with no entry, and the job ends on a garbage r0. So when the
  * callee comes back on a lifted entry, run it in this drain until the pc
  * reaches return_pc; only a pc with no lifted code behind it is unwound. */
+
+typedef struct {
+    uint32_t ea;
+    uint32_t lsa;
+    uint32_t size;
+    uint32_t cmd;
+    uint32_t tag;
+} spu_last_dma_t;
+extern spu_last_dma_t g_spu_last_dma_get[8];
+
+typedef struct {
+    uint32_t entry_pc;
+    uint32_t return_pc;
+    int image_id;
+    u128 gpr1;
+    u128 gpr4;
+    jmp_buf jmp;
+} spu_drain_frame_t;
+
+static SPU_THREAD_LOCAL spu_drain_frame_t s_drain_stack[64];
 typedef void (*spu_drain_fn)(spu_context*);
 extern spu_drain_fn spu_lookup(uint32_t addr, int image_id);
 
@@ -570,6 +591,27 @@ static void spu_drain_loop(spu_context* ctx, uint32_t return_pc, int any_return)
                 SPU_DRAIN_POP_IRQ();
                 return;
             }
+            if (ctx->host_depth >= 2) {
+                uint32_t cur_pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+                uint32_t ret_pc = return_pc & SPU_LS_MASK;
+                for (uint32_t d = 1; d < ctx->host_depth; d++) {
+                    if (s_drain_stack[d].entry_pc == cur_pc && s_drain_stack[d].return_pc == ret_pc) {
+                        static int s_unwind_log = 0;
+                        if (s_unwind_log < 10) {
+                            s_unwind_log++;
+                            fprintf(stderr, "[spu-unwind] Cycle detected at depth=%u: cur_pc=0x%05X ret_pc=0x%05X matches outer depth=%u; state-preserving resume at outer return_pc=0x%05X\n",
+                                    ctx->host_depth, cur_pc, ret_pc, d, s_drain_stack[d].return_pc);
+                        }
+                        SPU_DRAIN_POP_IRQ();
+                        ctx->host_depth = d;
+                        ctx->pc = s_drain_stack[d].return_pc;
+                        ctx->gpr[1] = s_drain_stack[d].gpr1;
+                        ctx->gpr[4] = s_drain_stack[d].gpr4;
+                        g_spu_trampoline_fn = 0;
+                        longjmp(s_drain_stack[d].jmp, 1);
+                    }
+                }
+            }
             void (*fn)(spu_context*) = g_spu_trampoline_fn;
             g_spu_trampoline_fn = 0;
             ctx->drain_ret_pc = return_pc & SPU_LS_MASK;   /* re-set: a nested drain changed it */
@@ -631,6 +673,62 @@ static void spu_drain_loop(spu_context* ctx, uint32_t return_pc, int any_return)
 
 void spu_drain_call(spu_context* ctx, uint32_t return_pc)
 {
+    if ((ctx->pc & SPU_LS_MASK) == (return_pc & SPU_LS_MASK)) {
+        return;
+    }
+    if (ctx->host_depth < 64) {
+        s_drain_stack[ctx->host_depth].entry_pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+        s_drain_stack[ctx->host_depth].return_pc = return_pc & SPU_LS_MASK;
+        s_drain_stack[ctx->host_depth].image_id = ctx->image_id;
+        s_drain_stack[ctx->host_depth].gpr1 = ctx->gpr[1];
+        s_drain_stack[ctx->host_depth].gpr4 = ctx->gpr[4];
+        if (setjmp(s_drain_stack[ctx->host_depth].jmp) != 0) {
+            /* State-preserving return from inner cycle */
+            return;
+        }
+    }
+    if ((return_pc & SPU_LS_MASK) == 0x02D74) {
+        unsigned lane = ctx->spu_id & 7;
+        static uint32_t s_calls[8] = {0};
+        uint32_t call_num = ++s_calls[lane];
+        if (call_num <= 5 || call_num == 1000) {
+            uint32_t r4_0 = ctx->gpr[4]._u32[0];
+            uint32_t r4_1 = ctx->gpr[4]._u32[1];
+            uint32_t r4_2 = ctx->gpr[4]._u32[2];
+            uint32_t r4_3 = ctx->gpr[4]._u32[3];
+            spu_last_dma_t last_dma = g_spu_last_dma_get[lane];
+            uint32_t desc_ea = last_dma.ea;
+            extern uint8_t* vm_base;
+            fprintf(stderr, "\n=== [TASK4-JOB-DESC] SPU lane=%u call=%u return_pc=0x02D74 entry_pc=0x%05X ===\n",
+                    lane, call_num, (uint32_t)ctx->pc & SPU_LS_MASK);
+            fprintf(stderr, "  r4 (4 words): 0x%08X 0x%08X 0x%08X 0x%08X\n", r4_0, r4_1, r4_2, r4_3);
+            fprintf(stderr, "  last DMA GET: cmd=0x%02X lsa=0x%05X ea=0x%08X size=%u tag=%u\n",
+                    last_dma.cmd, last_dma.lsa, last_dma.ea, last_dma.size, last_dma.tag);
+            fprintf(stderr, "  descriptor EA: 0x%08X\n", desc_ea);
+            if (vm_base && desc_ea && desc_ea < 0xFFFFFFC0u) {
+                const uint32_t* p = (const uint32_t*)(vm_base + desc_ea);
+                fprintf(stderr, "  descriptor 64B in guest RAM:\n");
+                for (int i = 0; i < 4; i++) {
+                    fprintf(stderr, "    +0x%02X: %08X %08X %08X %08X\n",
+                            i * 16,
+                            __builtin_bswap32(p[i * 4 + 0]), __builtin_bswap32(p[i * 4 + 1]),
+                            __builtin_bswap32(p[i * 4 + 2]), __builtin_bswap32(p[i * 4 + 3]));
+                }
+            } else {
+                fprintf(stderr, "  descriptor in guest RAM: (invalid EA or null vm_base)\n");
+            }
+            fprintf(stderr, "  first 64B of LS (0x00..0x40):\n");
+            const uint32_t* ls = (const uint32_t*)ctx->ls;
+            for (int i = 0; i < 4; i++) {
+                fprintf(stderr, "    +0x%02X: %08X %08X %08X %08X\n",
+                        i * 16,
+                        __builtin_bswap32(ls[i * 4 + 0]), __builtin_bswap32(ls[i * 4 + 1]),
+                        __builtin_bswap32(ls[i * 4 + 2]), __builtin_bswap32(ls[i * 4 + 3]));
+            }
+            fprintf(stderr, "=======================================================================\n\n");
+            fflush(stderr);
+        }
+    }
     spu_drain_loop(ctx, return_pc, 0);
 }
 
