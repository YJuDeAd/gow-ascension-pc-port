From 46449ab7cb3beaaf38a449e596baff01f9f0bc63 Mon Sep 17 00:00:00 2001
From: YJuDeAd <robinrashi@gmail.com>
Date: Mon, 26 Oct 2026 03:15:55 +0530
Subject: [PATCH] feat(spu): unwind repeating spu_drain_call frames via clean C
 return

---
 runtime/spu/spu_drain.c | 48 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 45 insertions(+), 3 deletions(-)

diff --git a/runtime/spu/spu_drain.c b/runtime/spu/spu_drain.c
index c5e7348..5d2e466 100644
--- a/runtime/spu/spu_drain.c
+++ b/runtime/spu/spu_drain.c
@@ -526,7 +526,7 @@ if (ctx->host_depth < s_max) return;
     if (s_reported < 1) {   /* one report: five SPU threads all trip together */
         s_reported++;
         fprintf(stderr, "[spu-depth] img=%d pc=0x%05X lr=0x%05X host_depth=%u"
-                        " -- lifted call recursion unwinding to driver stack\n",
+                        " -- lifted call recursion, halting the SPU\n",
                 ctx->image_id, (uint32_t)ctx->pc & SPU_LS_MASK,
                 ctx->gpr[0]._u32[0] & SPU_LS_MASK, ctx->host_depth);
         fprintf(stderr, "[spu-depth] recent drain sites (oldest first):");
@@ -536,8 +536,8 @@ if (ctx->host_depth < s_max) return;
         fprintf(stderr, "\n");
         fflush(stderr);
     }
-    extern void spu_restart_dispatch(spu_context*);
-    spu_restart_dispatch(ctx);
+    extern void spu_halt(spu_context*);
+    spu_halt(ctx);
 }
 
 /* See spu_context.h. Env-gated: SPU_TAILRET=1. */
@@ -571,6 +571,15 @@ SPU_THREAD_LOCAL int g_spu_drain_anyret;
 typedef void (*spu_drain_fn)(spu_context*);
 extern spu_drain_fn spu_lookup(uint32_t addr, int image_id);
 
+typedef struct {
+    uint32_t entry_pc;
+    uint32_t return_pc;
+    int image_id;
+} spu_drain_frame_t;
+
+static SPU_THREAD_LOCAL spu_drain_frame_t s_drain_stack[64];
+static SPU_THREAD_LOCAL int s_depth32_logged = 0;
+
 static void spu_drain_loop(spu_context* ctx, uint32_t return_pc, int any_return)
 {
     const int outer_anyret = g_spu_drain_anyret;
@@ -591,6 +600,22 @@ static void spu_drain_loop(spu_context* ctx, uint32_t return_pc, int any_return)
                 SPU_DRAIN_POP_IRQ();
                 return;
             }
+            if (ctx->host_depth >= 2) {
+                uint32_t cur_pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+                uint32_t ret_pc = return_pc & SPU_LS_MASK;
+                for (uint32_t d = 1; d < ctx->host_depth; d++) {
+                    if (s_drain_stack[d].entry_pc == cur_pc && s_drain_stack[d].return_pc == ret_pc) {
+                        static int s_unwind_log = 0;
+                        if (s_unwind_log < 10) {
+                            s_unwind_log++;
+                            fprintf(stderr, "[spu-unwind] Cycle detected at depth=%u: cur_pc=0x%05X ret_pc=0x%05X matches outer depth=%u; returning from inner drain\n",
+                                    ctx->host_depth, cur_pc, ret_pc, d);
+                        }
+                        SPU_DRAIN_POP_IRQ();
+                        return;
+                    }
+                }
+            }
             void (*fn)(spu_context*) = g_spu_trampoline_fn;
             g_spu_trampoline_fn = 0;
             ctx->drain_ret_pc = return_pc & SPU_LS_MASK;   /* re-set: a nested drain changed it */
@@ -650,8 +675,25 @@ static void spu_drain_loop(spu_context* ctx, uint32_t return_pc, int any_return)
 #undef SPU_DRAIN_POP_IRQ
 }
 
+
 void spu_drain_call(spu_context* ctx, uint32_t return_pc)
 {
+    if (ctx->host_depth < 64) {
+        s_drain_stack[ctx->host_depth].entry_pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+        s_drain_stack[ctx->host_depth].return_pc = return_pc & SPU_LS_MASK;
+        s_drain_stack[ctx->host_depth].image_id = ctx->image_id;
+    }
+    if (ctx->host_depth == 32 && !s_depth32_logged) {
+        s_depth32_logged = 1;
+        fprintf(stderr, "\n=== [SPU-DRAIN-STACK] SPU %u reached host_depth=32 (img=%d) ===\n",
+                (unsigned)(ctx->spu_id & 7u), ctx->image_id);
+        for (uint32_t d = 1; d <= 32; d++) {
+            fprintf(stderr, "  depth=%02u entry_pc=0x%05X return_pc=0x%05X img=%d\n",
+                    d, s_drain_stack[d].entry_pc, s_drain_stack[d].return_pc, s_drain_stack[d].image_id);
+        }
+        fprintf(stderr, "===============================================================\n\n");
+        fflush(stderr);
+    }
     spu_drain_loop(ctx, return_pc, 0);
 }
 
-- 
