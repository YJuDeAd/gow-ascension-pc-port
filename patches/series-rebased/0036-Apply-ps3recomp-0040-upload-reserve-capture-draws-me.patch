+        if ((u64)start + (u64)pitch * lv[m].rows > UPLOAD_SIZE) { tex->lpVtbl->Release(tex); return NULL; }
         for (u32 y = 0; y < lv[m].rows; y++)
             memcpy(g.upload_mapped + start + (size_t)y * pitch,
                    lv[m].data + (size_t)y * lv[m].row_bytes, lv[m].row_bytes);
