 typedef struct { u32 w, h; const u8* data; u32 row_bytes, rows; } tex_level_t;
 
+/* Make room in the upload ring for `total` bytes of texel rows (each level's
+ * 512-byte alignment included), flushing the recorded work first when they
+ * do not fit; 0 if they never can. The texture paths used to stop copying
+ * mid-texture when the ring ran out and still hand back the resource, its
+ * remaining mips zero and its hash recorded, so it was never decoded again:
+ * God of War: Ascension's level loads its largest textures (Kratos' 2048x4096
+ * albedo and normals) together and drew him without his tattoo and scars. */
+static int ld_upload_reserve(u64 total)
+{
+    if (total > UPLOAD_SIZE) return 0;
+    if ((((u64)g.upload_used + 511u) & ~(u64)511u) + total > UPLOAD_SIZE)
+        ld_flush(LD_FLUSH_UPLOAD_RING);
+    return 1;
+}
+static u64 ld_levels_upload_bytes(const tex_level_t* lv, u32 n)
+{
+    u64 total = 0;
+    for (u32 m = 0; m < n; m++)
+        total += 511u + (u64)((lv[m].row_bytes + 255) & ~255u) * lv[m].rows;
+    return total;
+}
+
 static ID3D12Resource* create_texture_mipped(DXGI_FORMAT fmt, const tex_level_t* lv, u32 n)
 {
     if (n == 0) return NULL;
+    if (!ld_upload_reserve(ld_levels_upload_bytes(lv, n))) return NULL;
     D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
     D3D12_RESOURCE_DESC rd = {0};
