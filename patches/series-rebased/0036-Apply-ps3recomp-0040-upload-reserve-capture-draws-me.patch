     D3D12_RESOURCE_DESC rd = {0};
     rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
@@ -2159,6 +2204,120 @@ static u64 texture_content_hash(const rsx_dsp_texture* t, int* readable)
     return hash;
 }
 
+/* A 3D texture. God of War: Ascension's tone-map pass reads its fog as a
+ * 64x32xN pitch-linear W16Z16Y16X16_FLOAT volume (screen position by depth),
+ * which the 2D-only decoder refused: it sampled white, a full white haze over
+ * the whole frame. Pitch-linear float16 and ARGB8 volumes, identity remap. */
+static ID3D12Resource* decode_guest_volume(const rsx_dsp_texture* t, u32 remap)
+{
+    const u32 base_fmt = t->format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
+    const int linear = (t->format & TEX_FMT_LINEAR) != 0;
+    const u32 w = t->width, h = t->height, d = t->depth;
+    const u32 texel = base_fmt == RSX_TEX_FMT_W16Z16Y16X16_FLOAT ? 8u :
+                      base_fmt == TEX_FMT_A8R8G8B8 ? 4u : 0u;
+    static u32 logs = 0;
+    if (!texel || !linear || !w || !h || !d || w > 2048 || h > 2048 || d > 512 || t->cubemap ||
+        remap != 0xAAE4u) {
+        if (logs++ < 8)
+            fprintf(stderr, "[volume] unsupported %u:0x%X fmt=0x%02X %ux%ux%u remap=0x%X\n",
+                    t->location, t->offset, t->format, w, h, d, remap);
+        return NULL;
+    }
+    const u32 pitch = t->pitch ? t->pitch : w * texel;
+    const u8* src = guest_ptr(t->location, t->offset, pitch * h * d);
+    if (!src) return NULL;
+    const u32 row = w * texel, rows = h * d;
+    u8* texels = (u8*)malloc((size_t)row * rows);
+    if (!texels) return NULL;
+    /* LD_VOLUME_FLIPY=1 flips each slice's rows, LD_VOLUME_LE=1 reads the
+     * halves little-endian, LD_VOLUME_CLAMP=1 turns negative and non-finite
+     * halves into 0: interpretations to test against the PS3 frame (the fog
+     * still leaves black patches on the ground). The first decodes log each
+     * channel's range under both byte orders. */
+    static int flip = -1, le = 0, clampv = 0;
+    if (flip < 0) { const char* e = getenv("LD_VOLUME_FLIPY"); flip = e && e[0] == '1';
+                    e = getenv("LD_VOLUME_LE"); le = e && e[0] == '1';
+                    e = getenv("LD_VOLUME_CLAMP"); clampv = e && e[0] == '1'; }
+    if (texel == 8u && logs < 8) {
+        for (int order = 0; order < 2; order++) {
+            float mn[4] = {1e30f, 1e30f, 1e30f, 1e30f}, mx[4] = {-1e30f, -1e30f, -1e30f, -1e30f};
+            u32 neg[4] = {0}, bad[4] = {0};
+            for (u32 y = 0; y < rows; y++)
+                for (u32 x = 0; x < w; x++)
+                    for (u32 c = 0; c < 4; c++) {
+                        const u8* q = src + (size_t)y * pitch + x * 8u + c * 2u;
+                        const u16 hb = order ? (u16)(q[0] | (q[1] << 8)) : (u16)((q[0] << 8) | q[1]);
+                        const int ex = (hb >> 10) & 0x1F;
+                        if (ex == 31) { bad[c]++; continue; }
+                        float f = ex ? (1.0f + (float)(hb & 0x3FF) / 1024.0f) * ldexpf(1.0f, ex - 15)
+                                     : (float)(hb & 0x3FF) * ldexpf(1.0f, -24);
+                        if (hb & 0x8000) { f = -f; neg[c]++; }
+                        if (f < mn[c]) mn[c] = f;
+                        if (f > mx[c]) mx[c] = f;
+                    }
+            fprintf(stderr, "[volume] %u:0x%X %s: x[%g,%g] y[%g,%g] z[%g,%g] w[%g,%g] neg=%u/%u/%u/%u bad=%u/%u/%u/%u\n",
+                    t->location, t->offset, order ? "LE" : "BE", mn[0], mx[0], mn[1], mx[1], mn[2], mx[2], mn[3], mx[3],
+                    neg[0], neg[1], neg[2], neg[3], bad[0], bad[1], bad[2], bad[3]);
+        }
+    }
+    for (u32 y = 0; y < rows; y++) {
+        const u32 sy = flip ? (y / h) * h + (h - 1u - y % h) : y;
+        const u8* q = src + (size_t)sy * pitch;
+        u8* o = texels + (size_t)y * row;
+        if (texel == 8u)
+            for (u32 x = 0; x < w * 4u; x++) {
+                u8 hi = le ? q[x * 2 + 1] : q[x * 2], lo = le ? q[x * 2] : q[x * 2 + 1];
+                if (clampv && ((hi & 0x80) || (hi & 0x7C) == 0x7C)) hi = lo = 0;
+                o[x * 2] = lo; o[x * 2 + 1] = hi;
+            }
+        else
+            for (u32 x = 0; x < w; x++) {      /* A R G B -> R G B A */
+                o[x * 4] = q[x * 4 + 1]; o[x * 4 + 1] = q[x * 4 + 2];
+                o[x * 4 + 2] = q[x * 4 + 3]; o[x * 4 + 3] = q[x * 4];
+            }
+    }
+    const DXGI_FORMAT fmt = texel == 8u ? DXGI_FORMAT_R16G16B16A16_FLOAT : DXGI_FORMAT_R8G8B8A8_UNORM;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE3D;
+    rd.Width = w; rd.Height = h; rd.DepthOrArraySize = (UINT16)d;
+    rd.MipLevels = 1; rd.Format = fmt; rd.SampleDesc.Count = 1;
+    ID3D12Resource* tex = NULL;
+    const u32 upitch = (row + 255u) & ~255u;
+    ld_upload_reserve(511u + (u64)upitch * rows);
+    const u32 start = (g.upload_used + 511u) & ~511u;
+    if ((u64)start + (u64)upitch * rows > UPLOAD_SIZE ||
+        FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                                                      D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+                                                      &IID_ID3D12Resource, (void**)&tex))) {
+        free(texels);
+        return NULL;
+    }
+    for (u32 y = 0; y < rows; y++)
+        memcpy(g.upload_mapped + start + (size_t)y * upitch, texels + (size_t)y * row, row);
+    free(texels);
+    D3D12_TEXTURE_COPY_LOCATION sl = {0}, dl = {0};
+    sl.pResource = g.upload; sl.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    sl.PlacedFootprint.Offset = start;
+    sl.PlacedFootprint.Footprint.Format = fmt;
+    sl.PlacedFootprint.Footprint.Width = w;
+    sl.PlacedFootprint.Footprint.Height = h;
+    sl.PlacedFootprint.Footprint.Depth = d;
+    sl.PlacedFootprint.Footprint.RowPitch = upitch;
+    dl.pResource = tex; dl.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dl, 0, 0, 0, &sl, NULL);
+    g.upload_used = start + upitch * rows;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition.pResource = tex;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    if (logs++ < 8)
+        fprintf(stderr, "[volume] %u:0x%X fmt=0x%02X %ux%ux%u\n", t->location, t->offset, t->format, w, h, d);
+    return tex;
+}
+
 static ID3D12Resource* decode_guest_texture(const rsx_dsp_texture* t, u32 remap)
 {
     const u32 base_fmt = t->format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM;
