     statGet.isNewData = is_new ? 1 : 0;
     strncpy(statGet.dir.dirName, dirName, CELL_SAVEDATA_DIRNAME_SIZE - 1);
 
diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
