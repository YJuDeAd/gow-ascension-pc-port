diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 9230b725..63848597 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2120,6 +2120,14 @@ static DWORD WINAPI spurs_pm_worker(LPVOID p)
     struct SpursInst* si = slot->instance;
 #ifdef _WIN32
     { ULONG g = 256 * 1024; SetThreadStackGuarantee(&g); }
+    {
+        static int s_pin = -1;
+        if (s_pin < 0) { const char* e = getenv("SPURS_PIN"); s_pin = e && *e == '1'; }
+        if (s_pin) {
+            DWORD_PTR mask = (DWORD_PTR)1 << (slot->spu_num + 1);
+            SetThreadAffinityMask(GetCurrentThread(), mask);
+        }
+    }
 #endif
     ps3_tprof_thread('S', (uint32_t)slot->spu_num);
     AcquireSRWLockExclusive(&si->lock);
@@ -2232,18 +2240,19 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
     static int s_spin = -1;
     if (s_spin < 0) { const char* e = getenv("SPURS_KERNEL_SPIN"); s_spin = e && *e == '1'; }
     while (!si->stopping) {
-        /* A request line committed during the last pass: look again now. Such a
-         * pass serves only requested workloads and leaves pass_no alone, so the
-         * idle back-off probes keep their cadence however often SPUs write the
-         * line (a probed policy module that writes it cannot feed itself more
-         * probes). Every 16th kick pass in a row is a full one, so a steady
-         * stream of commits cannot starve the probes either. */
         int kick_pass = 0;
         if (__atomic_exchange_n(&si->kick, 0, __ATOMIC_ACQ_REL)) {
             kick_pass = ++kick_run < 16;
         } else {
             if (s_spin) { ReleaseSRWLockExclusive(&si->lock); SwitchToThread(); AcquireSRWLockExclusive(&si->lock); }
-            else SleepConditionVariableSRW(&si->wake, &si->lock, 1, 0);
+            else {
+                int any_busy = 0;
+                for (u32 k = 0; k < si->nspus; k++) {
+                    if (si->slots[k].busy) { any_busy = 1; break; }
+                }
+                DWORD wait_ms = any_busy ? 1 : 10;
+                SleepConditionVariableSRW(&si->wake, &si->lock, wait_ms, 0);
+            }
             /* This full pass reads the line after any commit that woke it. */
             (void)__atomic_exchange_n(&si->kick, 0, __ATOMIC_ACQ_REL);
         }
@@ -3737,17 +3746,28 @@ s32 cellSpursGetWorkloadInfo(u64 spurs_ea, u32 wid, u64 info_ea)
     vm_write32(base + 0x10, (u32)(uintptr_t)w->pm);              /* policyModule (32-bit EA) */
     vm_write32(base + 0x14, w->sizePm);                          /* sizePolicyModule */
     /* nameClass/nameInstance (0x18/0x1C): not tracked -> left 0 by the zero above. */
-
     u32 se = (u32)spurs_ea;
     const struct SpursInst* si = spurs_inst_find(se);
     const int is2 = si && si->is2;
-    *(vm_base + base + 0x20) = wkl_count_get(se, SPURS_WKL_CURCONT, wid, is2); /* contention */
+    AcquireSRWLockExclusive(&s_workload_registry_lock);
+    u8 cur_cont = wkl_count_get(se, SPURS_WKL_CURCONT, wid, is2);
+    u8 ready_cnt = *(vm_base + se + wkl_ready_off(wid));
+
+    if (wid == 9 || !w->in_use || !w->started || w->readyCount == 0) {
+        ready_cnt = 0;
+        cur_cont = 0;
+        *(vm_base + se + wkl_ready_off(wid)) = 0;
+        if (wid < 16) *(vm_base + se + SPURS_WKL_CURCONT + wid) = 0;
+    }
+
+    *(vm_base + base + 0x20) = cur_cont;                                   /* contention */
     *(vm_base + base + 0x21) = (u8)w->minContention;                       /* minContention */
     *(vm_base + base + 0x22) = (u8)w->maxContention;                       /* maxContention */
-    *(vm_base + base + 0x23) = *(vm_base + se + wkl_ready_off(wid));       /* readyCount   */
+    *(vm_base + base + 0x23) = ready_cnt;                                  /* readyCount */
     /* idleSpuRequest; a CellSpurs2 uses those bytes for readyCount2. */
     *(vm_base + base + 0x24) = is2 ? 0 : *(vm_base + se + SPURS_WKL_IDLE2 + wid);
     *(vm_base + base + 0x25) = (vm_read16(se + wkl_signal_off(wid)) & wkl_signal_bit(wid)) ? 1 : 0;
+    ReleaseSRWLockExclusive(&s_workload_registry_lock);
     return CELL_OK;
 }
 
@@ -3755,6 +3775,17 @@ s32 cellSpursShutdownWorkload(u64 spurs_ea, u32 wid)
 {
     static int _n = 0;
     if (PS3_LOG_FIRST(_n, 8)) printf("[cellSpurs] ShutdownWorkload(wid=%u)\n", wid);
+    if (wid < SPURS_MAX_WID) {
+        AcquireSRWLockExclusive(&s_workload_registry_lock);
+        s_workloads[wid].readyCount = 0;
+        s_workloads[wid].started = 0;
+        if (spurs_ea && vm_base) {
+            u32 se = (u32)spurs_ea;
+            *(vm_base + se + wkl_ready_off(wid)) = 0;
+            if (wid < 16) *(vm_base + se + SPURS_WKL_CURCONT + wid) = 0;
+        }
+        ReleaseSRWLockExclusive(&s_workload_registry_lock);
+    }
     return CELL_OK;
 }
 
@@ -3762,6 +3793,17 @@ s32 cellSpursWaitForWorkloadShutdown(u64 spurs_ea, u32 wid)
 {
     static int _n = 0;
     if (PS3_LOG_FIRST(_n, 8)) printf("[cellSpurs] WaitForWorkloadShutdown(wid=%u)\n", wid);
+    if (wid < SPURS_MAX_WID) {
+        AcquireSRWLockExclusive(&s_workload_registry_lock);
+        s_workloads[wid].readyCount = 0;
+        s_workloads[wid].started = 0;
+        if (spurs_ea && vm_base) {
+            u32 se = (u32)spurs_ea;
+            *(vm_base + se + wkl_ready_off(wid)) = 0;
+            if (wid < 16) *(vm_base + se + SPURS_WKL_CURCONT + wid) = 0;
+        }
+        ReleaseSRWLockExclusive(&s_workload_registry_lock);
+    }
     return CELL_OK;
 }
 
