diff --git a/runtime/spu/spu_context.h b/runtime/spu/spu_context.h
index f456304b..0be4e5ab 100644
--- a/runtime/spu/spu_context.h
+++ b/runtime/spu/spu_context.h
@@ -495,6 +495,13 @@ static inline void spu_context_init(spu_context* ctx, uint32_t spu_id)
     ctx->status = SPU_STATUS_STOPPED;
 }
 
+static inline uint32_t spu_ctx_lane(const spu_context* ctx)
+{
+    if (!ctx) return 0;
+    if (ctx->spu_id < 8) return ctx->spu_id;
+    return (uint32_t)(ctx->ls[0x1CB] & 7);
+}
