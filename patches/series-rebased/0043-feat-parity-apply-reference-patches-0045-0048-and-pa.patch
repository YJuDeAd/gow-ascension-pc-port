--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -507,7 +507,8 @@ static IoMapping* find_mapping_by_ea(u32 ea)
 static IoMapping* find_mapping_by_io(u32 io)
 {
     for (int i = 0; i < CELL_GCM_MAX_IO_MAPPINGS; i++) {
-        if (s_io_mappings[i].active && s_io_mappings[i].io == io)
+        if (s_io_mappings[i].active && (s_io_mappings[i].io == io ||
+            (io >= s_io_mappings[i].io && io < s_io_mappings[i].io + s_io_mappings[i].size)))
             return &s_io_mappings[i];
     }
     return NULL;
@@ -4036,8 +4037,14 @@ s32 cellGcmUnmapEaIoAddress(u32 ea)
 
     clear_offset_table(mapping->ea, mapping->io, mapping->size);
     mapping->active = 0;
+    mapping->ea = 0;
+    mapping->io = 0;
+    mapping->size = 0;
     s_io_mapping_count--;
 
+    if (s_offset_tables_published)
+        gcm_publish_offset_tables();
+
     return CELL_OK;
 }
 
