                                   s32 sizeKB, u32 fileNum)
 {
-    vm_write32(addr + 0,    1024 * 1024);    /* hddFreeSizeKB = 1 GB */
+    vm_write32(addr + 0,    10 * 1024 * 1024);    /* hddFreeSizeKB = 10 GB */
     vm_write32(addr + 4,    is_new ? 1 : 0); /* isNewData */
     vm_write64(addr + 8,    0);              /* dir.st_atime */
