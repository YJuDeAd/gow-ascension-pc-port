+/* F12 while the game window has focus: capture one frame for diagnosis into
+ * <LD_CAPTURE_DIR or captures>\cap_<frame>\ -- every draw of the next frame
+ * with its textures and shader (capture.txt, pso_*.ps.txt), the target before
+ * each pass, then all live surfaces and the presented image. A press during a
+ * capture is ignored. LD_CAPTURE_KEY=0: off. */
+/* End a capture: every live surface and what guest memory holds there. */
+static void ld_capture_finish(void)
+{
+    {
+        g_ld_cap_active = 0;
+        for (u32 i = 0; i < g.n_surfaces; i++) {
+            char path[MAX_PATH * 2];
+            snprintf(path, sizeof(path), "%s\\surf_%02u_%u_%08X_%ux%u.ppm", g_ld_cap_dir, i,
+                     g.surfaces[i].location, g.surfaces[i].offset, g.surfaces[i].w, g.surfaces[i].h);
+            ld_dump_surface_ppm(path, &g.surfaces[i]);
+            /* and what guest memory holds there (A R G B bytes), for buffers
+             * the CPU or SPUs fill */
+            if (g.surfaces[i].fmt == DXGI_FORMAT_R8G8B8A8_UNORM) {
+                const u32 gw = g.surfaces[i].w, gh = g.surfaces[i].h;
+                const u8* gm = guest_ptr(g.surfaces[i].location, g.surfaces[i].offset, gw * 4u * gh);
+                snprintf(path, sizeof(path), "%s\\guest_%02u_%u_%08X_%ux%u.ppm", g_ld_cap_dir, i,
+                         g.surfaces[i].location, g.surfaces[i].offset, gw, gh);
+                FILE* gf = gm ? fopen(path, "wb") : NULL;
+                if (gf) {
+                    fprintf(gf, "P6\n%u %u\n255\n", gw, gh);
+                    for (u32 p = 0; p < gw * gh; p++) fwrite(gm + (size_t)p * 4u + 1u, 1, 3, gf);
+                    fclose(gf);
+                }
+            }
+        }
+        /* The transform constants as they stand (512 x vec4, host u32 bit
+         * patterns): an RPCS3 .rrc only carries the constants its frame
+         * uploads, and rrc_replay --vpconst seeds the rest from this. */
+        { char path[MAX_PATH * 2];
+          snprintf(path, sizeof(path), "%s\\vp_constants.bin", g_ld_cap_dir);
+          FILE* cf = fopen(path, "wb");
+          if (cf) { fwrite(g.rsx.constants, 1, sizeof(g.rsx.constants), cf); fclose(cf); } }
+        if (g_ld_cap_log) {
+            fprintf(g_ld_cap_log, "[capture] %u draws, %u programs, %u surfaces\n",
+                    g_ld_cap_draws, g_ld_cap_nkeys, g.n_surfaces);
+            fclose(g_ld_cap_log);
+            g_ld_cap_log = NULL;
+        }
+        fprintf(stderr, "[capture] done: %s (%u draws)\n", g_ld_cap_dir, g_ld_cap_draws);
+    }
+}
+
+static void ld_capture_poll(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_CAPTURE_KEY"); on = !(e && e[0] == '0'); }
+    if (!on || g_ld_cap_active) return;    /* a capture ends by draw count (bind trace) */
+    const SHORT k = GetAsyncKeyState(VK_F12);
+    static int was_down = 0;
+    const int down = (k & 0x8000) != 0;
+    const int pressed = down && !was_down;
+    was_down = down;
+    if (!pressed) return;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(GetForegroundWindow(), &pid);
+    if (pid != GetCurrentProcessId()) return;
+    const char* base = getenv("LD_CAPTURE_DIR");
+    if (!base || !base[0]) base = "captures";
+    CreateDirectoryA(base, NULL);
+    snprintf(g_ld_cap_dir, sizeof g_ld_cap_dir, "%s\\cap_%06u", base, g_ld_frames);
+    CreateDirectoryA(g_ld_cap_dir, NULL);
+    char path[MAX_PATH * 2];
+    snprintf(path, sizeof path, "%s\\capture.txt", g_ld_cap_dir);
+    g_ld_cap_log = fopen(path, "w");
+    g_ld_cap_draws = 0;
+    g_ld_cap_nkeys = 0;
+    g_ld_cap_active = g_ld_cap_log != NULL;
+    char full[MAX_PATH];
+    if (!GetFullPathNameA(g_ld_cap_dir, sizeof full, full, NULL)) snprintf(full, sizeof full, "%s", g_ld_cap_dir);
+    fprintf(stderr, "[capture] F12: capturing frame %u into %s\n", g_ld_frames, full);
+}
