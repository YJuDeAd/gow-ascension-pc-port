 runtime/ppu/ppu_loader.cpp  |  6 +++-
 runtime/ppu/ppu_sysprx.cpp  |  1 +
 runtime/spu/spu_coherency.c | 11 ++++--
 tools/ppu_lifter.py         | 70 +++++++++++++++++++++++++++++++++++++
 5 files changed, 86 insertions(+), 3 deletions(-)

