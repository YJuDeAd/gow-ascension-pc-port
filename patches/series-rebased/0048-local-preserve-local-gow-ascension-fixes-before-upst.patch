 #include "../include/ps3rsx.h"
 #include <cstdio>
+#include <windows.h>
+
+static LONG WINAPI smoke_veh(EXCEPTION_POINTERS* ep) {
+    DWORD code = ep->ExceptionRecord->ExceptionCode;
+    if (code == 0x40010006 || code == 0x406D1388 || code == 0xE06D7363) return EXCEPTION_CONTINUE_SEARCH;
+    fprintf(stderr, "[SMOKE-CRASH] code=0x%08lX rip=%p\n",
+            (unsigned long)code, ep->ExceptionRecord->ExceptionAddress);
+    if (code == EXCEPTION_ACCESS_VIOLATION) {
+        fprintf(stderr, "[SMOKE-CRASH] %s fault at %p\n",
+                ep->ExceptionRecord->ExceptionInformation[0] ? "write" : "read",
+                (void*)ep->ExceptionRecord->ExceptionInformation[1]);
+    }
+    HMODULE mod = NULL;
+    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                       (LPCSTR)ep->ExceptionRecord->ExceptionAddress, &mod);
+    char mname[MAX_PATH] = "unknown";
+    if (mod) GetModuleFileNameA(mod, mname, sizeof(mname));
+    fprintf(stderr, "[SMOKE-CRASH] module=%p (%s) rva=0x%llX\n",
+            mod, mname, (unsigned long long)((char*)ep->ExceptionRecord->ExceptionAddress - (char*)mod));
+
+    void* frames[16];
+    USHORT n = RtlCaptureStackBackTrace(0, 16, frames, NULL);
+    for (USHORT i = 0; i < n; i++) {
+        HMODULE m = NULL;
+        GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR)frames[i], &m);
+        char fn[MAX_PATH] = "unknown";
+        if (m) GetModuleFileNameA(m, fn, sizeof(fn));
+        fprintf(stderr, "  #%u %p rva=0x%llX (%s)\n", i, frames[i],
+                m ? (unsigned long long)((char*)frames[i] - (char*)m) : 0, fn);
+    }
+    fflush(stderr);
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+
 
 int main(int argc, char** argv)
 {
+    AddVectoredExceptionHandler(1, smoke_veh);
     (void)argc; (void)argv;
     printf("[ps3rsx_flip_smoke] Running RPCS3 RSX subsystem smoke test...\n");
     
