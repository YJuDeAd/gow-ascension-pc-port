+/* LD_ZPROBE=<zeta offset hex>[,<from frame>]: one frame of a zeta's life.
+ *
+ * Every draw of that frame bound to the zeta prints its depth, stencil and
+ * polygon-offset state, the position stream, and the depth of vertices 0..2
+ * computed on the CPU through vp_c[264..267] (the transform these titles'
+ * prepass and colour-pass programs both use); the first EQUAL draw then reads
+ * the zeta back (min/max/histogram). A colour pass that tests EQUAL against
+ * its prepass and passes nowhere leaves the question "what is in the depth
+ * buffer?", which nothing else answers. */
+static u32 topology_vertex_index(u32 occurrence);
+
+static void ld_zprobe_readback(u32 zslot)
+{
+    zdepth_t* z = &g.zdepths[zslot - 1];
+    const u32 prior_write = z->had_write;
+    z->had_write = 1;                        /* resolve whatever it holds now */
+    const int ok = zdepth_snapshot(zslot);
+    z->had_write = prior_write;
+    if (!ok || !z->snapshot) {
+        fprintf(stderr, "[zprobe] readback: no snapshot (ok=%d)\n", ok);
+        return;
+    }
+    const u32 w = z->snapshot_w, h = z->snapshot_h;
+    const u32 pitch = (w * 4u + 255u) & ~255u;
+    const UINT64 rb_size = (UINT64)pitch * h;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = rb_size;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+            D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb)))
+        return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = z->snapshot;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = z->snapshot_state;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = z->snapshot; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R32_FLOAT;
+    dst.PlacedFootprint.Footprint.Width = w;
+    dst.PlacedFootprint.Footprint.Height = h;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = z->snapshot_state;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+    ld_flush(LD_FLUSH_READBACK);
+    u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)rb_size};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        float mn = 1e30f, mx = -1e30f; u64 ones = 0, zeros = 0, hist[10] = {0};
+        for (u32 y = 0; y < h; y++) {
+            const float* row = (const float*)(px + (SIZE_T)y * pitch);
+            for (u32 x = 0; x < w; x++) {
+                const float d = row[x];
+                if (d < mn) mn = d;
+                if (d > mx) mx = d;
+                if (d == 1.0f) ones++;
+                if (d == 0.0f) zeros++;
+                int bin = (int)(d * 10.0f); if (bin < 0) bin = 0; if (bin > 9) bin = 9;
+                hist[bin]++;
+            }
+        }
+        fprintf(stderr, "[zprobe] readback %ux%u min=%.7f max=%.7f ==1:%llu ==0:%llu hist:",
+                w, h, mn, mx, (unsigned long long)ones, (unsigned long long)zeros);
+        for (int i = 0; i < 10; i++) fprintf(stderr, " %llu", (unsigned long long)hist[i]);
+        fprintf(stderr, "\n[zprobe] samples:");
+        for (u32 k = 1; k < 8; k++) {
+            const u32 sx = w * k / 8u, sy = h * k / 8u;
+            fprintf(stderr, " (%u,%u)=%.7f", sx, sy, ((const float*)(px + (SIZE_T)sy * pitch))[sx]);
+        }
+        fprintf(stderr, "\n");
+        D3D12_RANGE wr = {0, 0};
+        rb->lpVtbl->Unmap(rb, 0, &wr);
+    }
+    rb->lpVtbl->Release(rb);
+}
