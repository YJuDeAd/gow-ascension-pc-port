+/* ---------------------------------------------------------------------------
+ * LD_PERF_OVERLAY=1: frame rate, frame time, speed, CPU and GPU use in the
+ * top-right corner of the window.
+ *
+ * The text is drawn on the CPU into a small RGBA image (a 5x7 bitmap font at
+ * twice its size) and copied into the backbuffer after the frame, so it needs
+ * no pipeline of its own and never touches the guest's surfaces.
+ *   FPS  presented frames per second (half-second window)
+ *   MS   the frame time behind it
+ *   SPD  speed against the title's native 30 frames per second
+ *   CPU  this process, as a share of the whole machine
+ *   GPU  this process's 3D engine, the counter Task Manager shows
+ *        (PDH "GPU Engine(pid_<pid>_*engtype_3D)\Utilization Percentage")
+ * ponytail: LD_PERF_OVERLAY_FPS=<n> sets the native rate SPD compares with.
+ * -------------------------------------------------------------------------*/
+#include <pdh.h>
+#pragma comment(lib, "pdh.lib")
+
+#define LD_OVL_W     136
+#define LD_OVL_H     100
+#define LD_OVL_PITCH ((LD_OVL_W * 4 + 255) & ~255)
+
+static const struct { char c; u8 rows[7]; } k_ld_glyphs[] = {
+    {'0', {0x0E,0x11,0x13,0x15,0x19,0x11,0x0E}}, {'1', {0x04,0x0C,0x04,0x04,0x04,0x04,0x0E}},
+    {'2', {0x0E,0x11,0x01,0x02,0x04,0x08,0x1F}}, {'3', {0x1F,0x02,0x04,0x02,0x01,0x11,0x0E}},
+    {'4', {0x02,0x06,0x0A,0x12,0x1F,0x02,0x02}}, {'5', {0x1F,0x10,0x1E,0x01,0x01,0x11,0x0E}},
+    {'6', {0x06,0x08,0x10,0x1E,0x11,0x11,0x0E}}, {'7', {0x1F,0x01,0x02,0x04,0x08,0x08,0x08}},
+    {'8', {0x0E,0x11,0x11,0x0E,0x11,0x11,0x0E}}, {'9', {0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C}},
+    {'F', {0x1F,0x10,0x10,0x1E,0x10,0x10,0x10}}, {'P', {0x1E,0x11,0x11,0x1E,0x10,0x10,0x10}},
+    {'S', {0x0F,0x10,0x10,0x0E,0x01,0x01,0x1E}}, {'C', {0x0E,0x11,0x10,0x10,0x10,0x11,0x0E}},
+    {'U', {0x11,0x11,0x11,0x11,0x11,0x11,0x0E}}, {'G', {0x0E,0x11,0x10,0x17,0x11,0x11,0x0F}},
+    {'D', {0x1C,0x12,0x11,0x11,0x11,0x12,0x1C}}, {'M', {0x11,0x1B,0x15,0x15,0x11,0x11,0x11}},
+    {'%', {0x18,0x19,0x02,0x04,0x08,0x13,0x03}}, {'.', {0x00,0x00,0x00,0x00,0x00,0x0C,0x0C}},
+    {'-', {0x00,0x00,0x00,0x1F,0x00,0x00,0x00}},
+};
+
+static void ld_ovl_text(u8* img, u32 x, u32 y, const char* s, u8 r, u8 gg, u8 b)
+{
+    for (; *s; s++, x += 12) {
+        const u8* rows = NULL;
+        for (u32 k = 0; k < sizeof k_ld_glyphs / sizeof k_ld_glyphs[0]; k++)
+            if (k_ld_glyphs[k].c == *s) { rows = k_ld_glyphs[k].rows; break; }
+        if (!rows) continue;                                   /* space, unknown */
+        for (u32 ry = 0; ry < 7; ry++)
+            for (u32 rx = 0; rx < 5; rx++) {
+                if (!((rows[ry] >> (4 - rx)) & 1)) continue;
+                for (u32 dy = 0; dy < 2; dy++)
+                    for (u32 dx = 0; dx < 2; dx++) {
+                        const u32 px = x + rx * 2 + dx, py = y + ry * 2 + dy;
+                        if (px >= LD_OVL_W || py >= LD_OVL_H) continue;
+                        u8* p = img + (size_t)py * LD_OVL_PITCH + px * 4;
+                        p[0] = r; p[1] = gg; p[2] = b; p[3] = 255;
+                    }
+            }
+    }
+}
