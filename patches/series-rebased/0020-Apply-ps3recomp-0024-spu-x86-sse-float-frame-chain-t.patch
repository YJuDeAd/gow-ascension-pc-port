From 54dc9c415cfb9bcca0ace82c0460c1f64eb61877 Mon Sep 17 00:00:00 2001
From: YJuDeAd <robinrashi@gmail.com>
Date: Thu, 12 Nov 2026 00:30:18 +0530
Subject: [PATCH 20/49] Apply
 ps3recomp-0024-spu-x86-sse-float-frame-chain-times.patch

# Conflicts:
#	libs/video/cellGcmSys.c
#	runtime/spu/spu_helpers.h
---
 runtime/ppu/ppu_loader.cpp       |  5 +++--
 runtime/spu/spu_channels.c       | 15 ++++++++++++---
 templates/project/CMakeLists.txt | 12 +++++++++++-
 3 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
index 067e8ad0..d4af0f4a 100644
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -48,6 +48,7 @@
 #include <unistd.h>
 #endif
 extern "C" uint32_t ppu_prof_resolve_host(void* ra);
+extern "C" unsigned long long ps3_qpc_us(void);   /* cellGcmSys.c: [ww] t= */
 
 /* Resolve the GUEST function on the host stack (closest lifted entry below
  * each frame) -- the same trick the [BLOCK] profiler uses. */
@@ -2051,9 +2052,9 @@ static __attribute__((noinline)) void barrier_watch_hit_slow(uint32_t a, uint32_
                * as three different guest functions. ctx->lr is written by the
                * lifter at every direct call site, so it names the real caller. */
               extern PPU_THREAD_LOCAL ppu_context* g_active_ctx;
-              fprintf(stderr, "[ww] 0x%08X <- 0x%X (w%d) guest-fn=0x%08X"
+              fprintf(stderr, "[ww] t=%lluus 0x%08X <- 0x%X (w%d) guest-fn=0x%08X"
                               " lr=0x%08X tid=%u\n",
-                      a, v, width, ppu_prof_resolve_host(ra),
+                      ps3_qpc_us(), a, v, width, ppu_prof_resolve_host(ra),
                       g_active_ctx ? (uint32_t)g_active_ctx->lr : 0u,
                       g_active_ctx ? (unsigned)g_active_ctx->thread_id : 0u);
               /* On the first write to the watched word, dump the guest caller
diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index 06eed93f..fc4e4da8 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -1032,9 +1032,18 @@ static int spu_mfc_atomic(spu_context* ctx, uint32_t cmd)
           if (s_v < 0) { const char* e = getenv("SPU_ATOM_EA");
                          s_vl = e ? (uint32_t)strtoul(e, 0, 16) & ~127u : 0; s_v = s_vl ? 1 : 0; }
           if (s_v && (ea & ~127u) == s_vl)
-              fprintf(stderr, "[atom-ea] PUTLLC %s lr=0x%05X ea=0x%08X\n",
-                      ctx->atomic_stat ? "FAIL" : "OK",
-                      ctx->gpr[0]._u32[0] & SPU_LS_MASK, ea); }
+          { extern unsigned long long ps3_qpc_us(void);
+            /* t= and the line's words after the commit, so commits line up
+             * with the GPU's [GET_REPORT] and the PPU's [ww] on one clock. */
+            const uint8_t* r = vm_base + (ea & ~127u);
+            char w[400]; int o = 0;
+            for (int i = 0; i < 128 && o < (int)sizeof w - 10; i += 4)
+                o += snprintf(w + o, sizeof w - (size_t)o, "%s%02X%02X%02X%02X", i ? " " : "",
+                              r[i], r[i + 1], r[i + 2], r[i + 3]);
+            fprintf(stderr, "[atom-ea] t=%lluus PUTLLC %s lr=0x%05X ea=0x%08X wid=%u RAM=%s\n",
+                    ps3_qpc_us(), ctx->atomic_stat ? "FAIL" : "OK",
+                    ctx->gpr[0]._u32[0] & SPU_LS_MASK, ea,
+                    ctx->policy_mode ? ctx->ls[0x1DF] : 255u, w); } }
         ctx->resv_valid = 0;                           /* reservation consumed */
         spu_lockline_unlock();
         if (ctx->atomic_stat == 0) {
diff --git a/templates/project/CMakeLists.txt b/templates/project/CMakeLists.txt
index 35c7d4d2..d3a84f37 100644
--- a/templates/project/CMakeLists.txt
+++ b/templates/project/CMakeLists.txt
@@ -194,7 +194,17 @@ if(SPU_SOURCES)
         INCLUDE_DIRECTORIES "${PS3RECOMP_DIR}/runtime/spu"
         COMPILE_DEFINITIONS SPU_USE_DISPATCH_MT)
     if(NOT MSVC OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
-        set_source_files_properties(${SPU_SOURCES} PROPERTIES COMPILE_OPTIONS "-O2")
+        # SSE4.1 as well (any x86-64 since ~2008): spu_shufb is pshufb/blendv
+        # only under __SSE4_1__, and without it every shufb in lifted code is
+        # a 16-byte loop (a third of the job worker in Ascension's profile).
+        # The runtime gets the same flag; probed, as Apple arm64 clang rejects it.
+        include(CheckCCompilerFlag)
+        check_c_compiler_flag(-msse4.1 PORT_HAS_MSSE41)
+        if(PORT_HAS_MSSE41)
+            set_source_files_properties(${SPU_SOURCES} PROPERTIES COMPILE_OPTIONS "-O2;-msse4.1")
+        else()
+            set_source_files_properties(${SPU_SOURCES} PROPERTIES COMPILE_OPTIONS "-O2")
+        endif()
     endif()
 endif()
 
