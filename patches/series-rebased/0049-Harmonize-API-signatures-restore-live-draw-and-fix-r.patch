+/* The D3D format of a colour surface. F_X32 is one 32-bit float per pixel:
+ * God of War: Ascension writes its linear view depth there and the depth of
+ * field reads it back as an X32_FLOAT texture. Stored as RGBA8 it clamped to
+ * 0..1 in 8 bits, every pixel read as far away and the whole menu scene came
+ * out blurred. Same 4 bytes a pixel, so readbacks keep their layout. */
+#define RSX_SURFACE_FMT_F_X32 0xD
+static DXGI_FORMAT ld_surface_dxgi(u32 color_format)
+{
+    if (color_format == RSX_SURFACE_FMT_F_W16Z16Y16X16) return DXGI_FORMAT_R16G16B16A16_FLOAT;
+    if (color_format == RSX_SURFACE_FMT_F_X32) {
+        static int on = -1;
+        if (on < 0) { const char* e = getenv("LD_SURF_X32"); on = !(e && e[0] == '0'); }
+        if (on) return DXGI_FORMAT_R32_FLOAT;
+    }
+    return DXGI_FORMAT_R8G8B8A8_UNORM;
+}
