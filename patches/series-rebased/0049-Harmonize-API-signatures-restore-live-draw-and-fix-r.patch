-    rs->rt_fp16 = alpha_surface.color_format == RSX_SURFACE_FMT_F_W16Z16Y16X16;
+    rs->rt_dxgi = (u32)ld_surface_dxgi(alpha_surface.color_format);
     rs->rt_count = ld_rt_count(alpha_surface.color_target);
     rs->blend_enable = rsx_dsp_reg(&g.rsx, M_BLEND_ENABLE) & 1;
     const u32 sf = rsx_dsp_reg(&g.rsx, M_BLEND_SFACTOR);
@@ -1627,6 +1791,102 @@ static D3D12_GPU_DESCRIPTOR_HANDLE sampler_table(const u32 slots[SMP_TABLE_SIZE]
 /* ---------------------------------------------------------------------------
  * command list submit/wait (simple synchronous model, like the harness)
  * -----------------------------------------------------------------------*/
+/* A small render target in main memory is a result the CPU or the SPUs read
+ * back: God of War: Ascension draws the scene's average luminance into a 1x1
+ * ARGB8 target at 1:0xAA0000 and its auto exposure reads it from there. The
+ * live renderer never wrote surfaces back, so the exposure ran on whatever
+ * that memory held and the menu came out washed out. At each flush, copy the
+ * targets drawn since the last one into a readback buffer and, once the fence
+ * has passed, store them in guest memory as the RSX would (A, R, G, B bytes).
+ * LD_SURF_WB=0: off. */
+#define LD_WB_MAX_PIXELS 256u
+static int ld_wb_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_SURF_WB"); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+static void ld_wb_mark(u32 target)
+{
+    if (target >= MAX_SURFACES || !ld_wb_enabled()) return;
+    surface_t* s = &g.surfaces[target];
+    if (s->location == 1 && s->w * s->h <= LD_WB_MAX_PIXELS && s->w <= 64 &&
+        s->fmt == DXGI_FORMAT_R8G8B8A8_UNORM)
+        s->wb_dirty = 1;
+}
+
+static int ld_wb_record(void)
+{
+    int n = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        surface_t* s = &g.surfaces[i];
+        if (!s->wb_dirty || !s->tex) continue;
+        if (!s->wb) {
+            D3D12_HEAP_PROPERTIES hp = {0};
+            hp.Type = D3D12_HEAP_TYPE_READBACK;
+            D3D12_RESOURCE_DESC bd = {0};
+            bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            bd.Width = 256u * s->h;
+            bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+            bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+            bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            if (FAILED(g.dev->lpVtbl->CreateCommittedResource(
+                    g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                    D3D12_RESOURCE_STATE_COPY_DEST, NULL,
+                    &IID_ID3D12Resource, (void**)&s->wb))) {
+                s->wb = NULL;
+                s->wb_dirty = 0;
+                continue;
+            }
+            fprintf(stderr, "[surf-wb] writing back %u:0x%X %ux%u\n", s->location, s->offset, s->w, s->h);
+        }
+        D3D12_RESOURCE_BARRIER b = {0};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = s->tex;
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+        D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+        src.pResource = s->tex; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        dst.pResource = s->wb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        dst.PlacedFootprint.Footprint.Format = s->fmt;
+        dst.PlacedFootprint.Footprint.Width = s->w;
+        dst.PlacedFootprint.Footprint.Height = s->h;
+        dst.PlacedFootprint.Footprint.Depth = 1;
+        dst.PlacedFootprint.Footprint.RowPitch = 256;
+        g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, NULL);
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+        s->wb_dirty = 2;    /* recorded: write it after this flush's fence */
+        n++;
+    }
+    return n;
+}
+
