diff --git a/runtime/rsx/rsx_backend.c b/runtime/rsx/rsx_backend.c
new file mode 100644
index 00000000..134f44ad
--- /dev/null
+++ b/runtime/rsx/rsx_backend.c
@@ -0,0 +1,414 @@
+/*
+ * ps3recomp - RSX Backend Implementation
+ */
+
+#include "rsx_backend.h"
+#include "libs/video/rsx_live_draw.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Forward declare D3D12 backend methods */
+static int      d3d12_init(void* hwnd, uint32_t width, uint32_t height,
+                           ps3_rsx_guest_ptr_fn guest_fn, void* user);
+static void     d3d12_shutdown(void);
+static void     d3d12_method(uint32_t method, uint32_t arg);
+static void     d3d12_set_display_buffer(uint32_t buffer_id, uint32_t location,
+                                         uint32_t offset, uint32_t pitch,
+                                         uint32_t width, uint32_t height);
+static void     d3d12_request_flip(uint32_t buffer_id);
+static int      d3d12_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                           uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                           uint32_t w, uint32_t h);
+static int      d3d12_resolve_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                                   uint32_t ds, uint32_t dt,
+                                   uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                                   uint32_t out_x, uint32_t out_y, uint32_t out_w, uint32_t out_h);
+static void     d3d12_note_resolve(uint32_t src_loc, uint32_t src_abs,
+                                   uint32_t dst_loc, uint32_t dst_abs);
+static void     d3d12_flush(void);
+static uint32_t d3d12_get_frames(void);
+static uint32_t d3d12_get_last_draws(void);
+static double   d3d12_get_present_fps(void);
+
+/* Forward declare RPCS3 RSX backend methods */
+static int      rpcs3_init(void* hwnd, uint32_t width, uint32_t height,
+                           ps3_rsx_guest_ptr_fn guest_fn, void* user);
+static void     rpcs3_shutdown(void);
+static void     rpcs3_method(uint32_t method, uint32_t arg);
+static void     rpcs3_set_display_buffer(uint32_t buffer_id, uint32_t location,
+                                         uint32_t offset, uint32_t pitch,
+                                         uint32_t width, uint32_t height);
+static void     rpcs3_request_flip(uint32_t buffer_id);
+static int      rpcs3_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                           uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                           uint32_t w, uint32_t h);
+static int      rpcs3_resolve_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                                   uint32_t ds, uint32_t dt,
+                                   uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                                   uint32_t out_x, uint32_t out_y, uint32_t out_w, uint32_t out_h);
+static void     rpcs3_note_resolve(uint32_t src_loc, uint32_t src_abs,
+                                   uint32_t dst_loc, uint32_t dst_abs);
+static void     rpcs3_flush(void);
+static uint32_t rpcs3_get_frames(void);
+static uint32_t rpcs3_get_last_draws(void);
+static double   rpcs3_get_present_fps(void);
+
+static Ps3RsxBackend s_d3d12_backend = {
+    "Direct3D 12 (Live Draw)",
+    PS3_RSX_RENDERER_D3D12,
+    d3d12_init,
+    d3d12_shutdown,
+    d3d12_method,
+    d3d12_set_display_buffer,
+    d3d12_request_flip,
+    d3d12_blit,
+    d3d12_resolve_blit,
+    d3d12_note_resolve,
+    d3d12_flush,
+    d3d12_get_frames,
+    d3d12_get_last_draws,
+    d3d12_get_present_fps
+};
+
+static Ps3RsxBackend s_rpcs3_rsx_backend = {
+    "RPCS3 RSX (Vulkan)",
+    PS3_RSX_RENDERER_RPCS3_RSX,
+    rpcs3_init,
+    rpcs3_shutdown,
+    rpcs3_method,
+    rpcs3_set_display_buffer,
+    rpcs3_request_flip,
+    rpcs3_blit,
+    rpcs3_resolve_blit,
+    rpcs3_note_resolve,
+    rpcs3_flush,
+    rpcs3_get_frames,
+    rpcs3_get_last_draws,
+    rpcs3_get_present_fps
+};
+
+/* Default backend is D3D12 */
+Ps3RsxBackend* g_rsx_backend = &s_d3d12_backend;
+
+void ps3_rsx_set_renderer_type(Ps3RsxRendererType type)
+{
+    if (type == PS3_RSX_RENDERER_RPCS3_RSX) {
+        g_rsx_backend = &s_rpcs3_rsx_backend;
+        fprintf(stderr, "[rsx-backend] Active renderer switched to: %s\n", g_rsx_backend->name);
+    } else {
+        g_rsx_backend = &s_d3d12_backend;
+        fprintf(stderr, "[rsx-backend] Active renderer switched to: %s\n", g_rsx_backend->name);
+    }
+}
+
+Ps3RsxRendererType ps3_rsx_get_renderer_type(void)
+{
+    return g_rsx_backend ? g_rsx_backend->type : PS3_RSX_RENDERER_D3D12;
+}
+
+Ps3RsxBackend* ps3_rsx_get_backend(void)
+{
+    return g_rsx_backend;
+}
+
+int ps3_rsx_parse_cli_renderer(int argc, char** argv)
+{
+    const char* env_rend = getenv("GOW_RENDERER");
+    if (env_rend) {
+        if (strcmp(env_rend, "rpcs3-rsx") == 0 || strcmp(env_rend, "rpcs3") == 0 || strcmp(env_rend, "vulkan") == 0) {
+            ps3_rsx_set_renderer_type(PS3_RSX_RENDERER_RPCS3_RSX);
+        } else {
+            ps3_rsx_set_renderer_type(PS3_RSX_RENDERER_D3D12);
+        }
+    }
+
+    if (!argv || argc <= 1) return 0;
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--renderer=rpcs3-rsx") == 0 || strcmp(argv[i], "--renderer=rpcs3") == 0) {
+            ps3_rsx_set_renderer_type(PS3_RSX_RENDERER_RPCS3_RSX);
+            return 1;
+        } else if (strcmp(argv[i], "--renderer=d3d12") == 0) {
+            ps3_rsx_set_renderer_type(PS3_RSX_RENDERER_D3D12);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Dispatchers */
+int ps3_rsx_backend_enabled(void)
+{
+    return rsx_live_draw_enabled();
+}
+
+int ps3_rsx_backend_init(void* hwnd, uint32_t width, uint32_t height,
+                         ps3_rsx_guest_ptr_fn guest_fn, void* user)
+{
+    if (!g_rsx_backend || !g_rsx_backend->init) return -1;
+    return g_rsx_backend->init(hwnd, width, height, guest_fn, user);
+}
+
+void ps3_rsx_backend_shutdown(void)
+{
+    if (g_rsx_backend && g_rsx_backend->shutdown) g_rsx_backend->shutdown();
+}
+
+void ps3_rsx_backend_method(uint32_t method, uint32_t arg)
+{
+    if (g_rsx_backend && g_rsx_backend->method) g_rsx_backend->method(method, arg);
+}
+
+void ps3_rsx_backend_set_display_buffer(uint32_t buffer_id, uint32_t location,
+                                       uint32_t offset, uint32_t pitch,
+                                       uint32_t width, uint32_t height)
+{
+    if (g_rsx_backend && g_rsx_backend->set_display_buffer)
+        g_rsx_backend->set_display_buffer(buffer_id, location, offset, pitch, width, height);
+}
+
+void ps3_rsx_backend_request_flip(uint32_t buffer_id)
+{
+    if (g_rsx_backend && g_rsx_backend->request_flip)
+        g_rsx_backend->request_flip(buffer_id);
+}
+
+int ps3_rsx_backend_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                         uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                         uint32_t w, uint32_t h)
+{
+    if (!g_rsx_backend || !g_rsx_backend->blit) return 0;
+    return g_rsx_backend->blit(src_loc, src_abs, src_pitch, dst_loc, dst_abs, dst_pitch, w, h);
+}
+
+int ps3_rsx_backend_resolve_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                                 uint32_t ds, uint32_t dt,
+                                 uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                                 uint32_t out_x, uint32_t out_y, uint32_t out_w, uint32_t out_h)
+{
+    if (!g_rsx_backend || !g_rsx_backend->resolve_blit) return 0;
+    return g_rsx_backend->resolve_blit(src_loc, src_abs, src_pitch, ds, dt,
+                                       dst_loc, dst_abs, dst_pitch,
+                                       out_x, out_y, out_w, out_h);
+}
+
+void ps3_rsx_backend_note_resolve(uint32_t src_loc, uint32_t src_abs,
+                                  uint32_t dst_loc, uint32_t dst_abs)
+{
+    if (g_rsx_backend && g_rsx_backend->note_resolve)
+        g_rsx_backend->note_resolve(src_loc, src_abs, dst_loc, dst_abs);
+}
+
+void ps3_rsx_backend_flush(void)
+{
+    if (g_rsx_backend && g_rsx_backend->flush) g_rsx_backend->flush();
+}
+
+uint32_t ps3_rsx_backend_get_frames(void)
+{
+    if (!g_rsx_backend || !g_rsx_backend->get_frames) return 0;
+    return g_rsx_backend->get_frames();
+}
+
+uint32_t ps3_rsx_backend_get_last_draws(void)
+{
+    if (!g_rsx_backend || !g_rsx_backend->get_last_draws) return 0;
+    return g_rsx_backend->get_last_draws();
+}
+
+double ps3_rsx_backend_get_present_fps(void)
+{
+    if (!g_rsx_backend || !g_rsx_backend->get_present_fps) return 0.0;
+    return g_rsx_backend->get_present_fps();
+}
+
+/* D3D12 implementation wrapping rsx_live_draw */
+static int d3d12_init(void* hwnd, uint32_t width, uint32_t height,
+                      ps3_rsx_guest_ptr_fn guest_fn, void* user)
+{
+    return rsx_live_draw_init(hwnd, width, height, (rsx_live_guest_ptr_fn)guest_fn, user);
+}
+
+static void d3d12_shutdown(void)
+{
+    rsx_live_draw_shutdown();
+}
+
+static void d3d12_method(uint32_t method, uint32_t arg)
+{
+    rsx_live_draw_method(method, arg);
+}
+
+static void d3d12_set_display_buffer(uint32_t buffer_id, uint32_t location,
+                                     uint32_t offset, uint32_t pitch,
+                                     uint32_t width, uint32_t height)
+{
+    rsx_live_draw_set_display_buffer(buffer_id, location, offset, pitch, width, height);
+}
+
+static void d3d12_request_flip(uint32_t buffer_id)
+{
+    rsx_live_draw_present(buffer_id);
+}
+
+static int d3d12_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                      uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                      uint32_t w, uint32_t h)
+{
+    return rsx_live_draw_blit(src_loc, src_abs, src_pitch, dst_loc, dst_abs, dst_pitch, w, h);
+}
+
+static int d3d12_resolve_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                              uint32_t ds, uint32_t dt,
+                              uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                              uint32_t out_x, uint32_t out_y, uint32_t out_w, uint32_t out_h)
+{
+    return rsx_live_draw_resolve_blit(src_loc, src_abs, src_pitch, ds, dt,
+                                      dst_loc, dst_abs, dst_pitch,
+                                      out_x, out_y, out_w, out_h);
+}
+
+static void d3d12_note_resolve(uint32_t src_loc, uint32_t src_abs,
+                               uint32_t dst_loc, uint32_t dst_abs)
+{
+    rsx_live_draw_note_resolve(src_loc, src_abs, dst_loc, dst_abs);
+}
+
+static void d3d12_flush(void)
+{
+    rsx_live_draw_flush();
+}
+
+static uint32_t d3d12_get_frames(void)
+{
+    return rsx_live_draw_get_frames();
+}
+
+static uint32_t d3d12_get_last_draws(void)
+{
+    return rsx_live_draw_get_last_draws();
+}
+
+static double d3d12_get_present_fps(void)
+{
+    return rsx_live_draw_get_present_fps();
+}
+
+/* RPCS3 RSX Vulkan Backend Scaffolding */
+static int rpcs3_init(void* hwnd, uint32_t width, uint32_t height,
+                      ps3_rsx_guest_ptr_fn guest_fn, void* user)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    fprintf(stderr, "[rpcs3-rsx] Initializing RPCS3 RSX Vulkan backend (%ux%u)...\n", width, height);
+    // Forward to ps3rsx_link / RPCS3 RSX subsystem
+    return 0;
+#else
+    fprintf(stderr, "[rpcs3-rsx] WARNING: RPCS3 RSX Vulkan backend requested but GOW_ENABLE_RPCS3_RSX=OFF at compile time. Falling back to D3D12.\n");
+    return d3d12_init(hwnd, width, height, guest_fn, user);
+#endif
+}
+
+static void rpcs3_shutdown(void)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    fprintf(stderr, "[rpcs3-rsx] Shutting down RPCS3 RSX Vulkan backend...\n");
+#endif
+}
+
+static void rpcs3_method(uint32_t method, uint32_t arg)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    // Dispatch into RPCS3 FIFO method sink
+#else
+    d3d12_method(method, arg);
+#endif
+}
+
+static void rpcs3_set_display_buffer(uint32_t buffer_id, uint32_t location,
+                                     uint32_t offset, uint32_t pitch,
+                                     uint32_t width, uint32_t height)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    // Set display buffer in RPCS3 surface manager
+#else
+    d3d12_set_display_buffer(buffer_id, location, offset, pitch, width, height);
+#endif
+}
+
+static void rpcs3_request_flip(uint32_t buffer_id)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    // Request flip on RPCS3 swapchain
+#else
+    d3d12_request_flip(buffer_id);
+#endif
+}
+
+static int rpcs3_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                      uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                      uint32_t w, uint32_t h)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    return 1;
+#else
+    return d3d12_blit(src_loc, src_abs, src_pitch, dst_loc, dst_abs, dst_pitch, w, h);
+#endif
+}
+
+static int rpcs3_resolve_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                              uint32_t ds, uint32_t dt,
+                              uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                              uint32_t out_x, uint32_t out_y, uint32_t out_w, uint32_t out_h)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    return 1;
+#else
+    return d3d12_resolve_blit(src_loc, src_abs, src_pitch, ds, dt,
+                              dst_loc, dst_abs, dst_pitch,
+                              out_x, out_y, out_w, out_h);
+#endif
+}
+
+static void rpcs3_note_resolve(uint32_t src_loc, uint32_t src_abs,
+                               uint32_t dst_loc, uint32_t dst_abs)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+#else
+    d3d12_note_resolve(src_loc, src_abs, dst_loc, dst_abs);
+#endif
+}
+
+static void rpcs3_flush(void)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+#else
+    d3d12_flush();
+#endif
+}
+
+static uint32_t rpcs3_get_frames(void)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    return 0;
+#else
+    return d3d12_get_frames();
+#endif
+}
+
+static uint32_t rpcs3_get_last_draws(void)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    return 0;
+#else
+    return d3d12_get_last_draws();
+#endif
+}
+
+static double rpcs3_get_present_fps(void)
+{
+#if defined(GOW_ENABLE_RPCS3_RSX) && GOW_ENABLE_RPCS3_RSX
+    return 0.0;
+#else
+    return d3d12_get_present_fps();
+#endif
+}
diff --git a/runtime/rsx/rsx_backend.h b/runtime/rsx/rsx_backend.h
