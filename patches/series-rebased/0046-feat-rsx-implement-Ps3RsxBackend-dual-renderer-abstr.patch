+++ b/runtime/rsx/rsx_backend.h
@@ -0,0 +1,95 @@
+/*
+ * ps3recomp - RSX Backend Abstraction (Dual-Renderer Architecture)
+ *
+ * Decouples cellGcmSys and runtime presentation from any single backend.
+ * Supports runtime selection between:
+ *   --renderer=d3d12     (default: Native NV4097 -> Direct3D 12 live draw engine)
+ *   --renderer=rpcs3-rsx (RPCS3 RSX Vulkan backend integration)
+ */
+
+#ifndef PS3RECOMP_RUNTIME_RSX_BACKEND_H
+#define PS3RECOMP_RUNTIME_RSX_BACKEND_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum Ps3RsxRendererType {
+    PS3_RSX_RENDERER_D3D12 = 0,
+    PS3_RSX_RENDERER_RPCS3_RSX = 1
+} Ps3RsxRendererType;
+
+/* Guest-memory resolver callback */
+typedef const uint8_t* (*ps3_rsx_guest_ptr_fn)(void* user, uint32_t location,
+                                               uint32_t offset, uint32_t min_bytes);
+
+/* Abstract RSX Backend vtable */
+typedef struct Ps3RsxBackend {
+    const char*        name;
+    Ps3RsxRendererType type;
+
+    int      (*init)(void* hwnd, uint32_t width, uint32_t height,
+                     ps3_rsx_guest_ptr_fn guest_fn, void* user);
+    void     (*shutdown)(void);
+    void     (*method)(uint32_t method, uint32_t arg);
+    void     (*set_display_buffer)(uint32_t buffer_id, uint32_t location, uint32_t offset,
+                                   uint32_t pitch, uint32_t width, uint32_t height);
+    void     (*request_flip)(uint32_t buffer_id);
+    int      (*blit)(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                     uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                     uint32_t w, uint32_t h);
+    int      (*resolve_blit)(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                             uint32_t ds, uint32_t dt,
+                             uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                             uint32_t out_x, uint32_t out_y, uint32_t out_w, uint32_t out_h);
+    void     (*note_resolve)(uint32_t src_loc, uint32_t src_abs,
+                             uint32_t dst_loc, uint32_t dst_abs);
+    void     (*flush)(void);
+
+    /* Telemetry */
+    uint32_t (*get_frames)(void);
+    uint32_t (*get_last_draws)(void);
+    double   (*get_present_fps)(void);
+} Ps3RsxBackend;
+
+/* Global active backend */
+extern Ps3RsxBackend* g_rsx_backend;
+
+/* Backend selection & query */
+void               ps3_rsx_set_renderer_type(Ps3RsxRendererType type);
+Ps3RsxRendererType ps3_rsx_get_renderer_type(void);
+Ps3RsxBackend*     ps3_rsx_get_backend(void);
+int                ps3_rsx_parse_cli_renderer(int argc, char** argv);
+
+/* Canonical runtime dispatchers */
+int      ps3_rsx_backend_enabled(void);
+int      ps3_rsx_backend_init(void* hwnd, uint32_t width, uint32_t height,
+                              ps3_rsx_guest_ptr_fn guest_fn, void* user);
+void     ps3_rsx_backend_shutdown(void);
+void     ps3_rsx_backend_method(uint32_t method, uint32_t arg);
+void     ps3_rsx_backend_set_display_buffer(uint32_t buffer_id, uint32_t location,
+                                            uint32_t offset, uint32_t pitch,
+                                            uint32_t width, uint32_t height);
+void     ps3_rsx_backend_request_flip(uint32_t buffer_id);
+int      ps3_rsx_backend_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                              uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                              uint32_t w, uint32_t h);
+int      ps3_rsx_backend_resolve_blit(uint32_t src_loc, uint32_t src_abs, uint32_t src_pitch,
+                                      uint32_t ds, uint32_t dt,
+                                      uint32_t dst_loc, uint32_t dst_abs, uint32_t dst_pitch,
+                                      uint32_t out_x, uint32_t out_y, uint32_t out_w, uint32_t out_h);
+void     ps3_rsx_backend_note_resolve(uint32_t src_loc, uint32_t src_abs,
+                                      uint32_t dst_loc, uint32_t dst_abs);
+void     ps3_rsx_backend_flush(void);
+uint32_t ps3_rsx_backend_get_frames(void);
+uint32_t ps3_rsx_backend_get_last_draws(void);
+double   ps3_rsx_backend_get_present_fps(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_RUNTIME_RSX_BACKEND_H */
