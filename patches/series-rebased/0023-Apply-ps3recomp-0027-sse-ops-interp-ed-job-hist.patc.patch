From e99ee0e1046f17238bef036901a402f03dbbc75c Mon Sep 17 00:00:00 2001
From: YJuDeAd <robinrashi@gmail.com>
Date: Thu, 12 Nov 2026 00:32:34 +0530
Subject: [PATCH 23/49] Apply ps3recomp-0027-sse-ops-interp-ed-job-hist.patch

# Conflicts:
#	runtime/spu/spu_channels.c
#	runtime/spu/spu_drain.c
#	runtime/spu/spu_helpers.h
#	runtime/spu/spu_interp.c
---
 runtime/spu/tests/test_spu_sse_ops.c | 75 ++++++++++++++++++++++++++++
 1 file changed, 75 insertions(+)
 create mode 100644 runtime/spu/tests/test_spu_sse_ops.c

diff --git a/runtime/spu/tests/test_spu_sse_ops.c b/runtime/spu/tests/test_spu_sse_ops.c
new file mode 100644
index 00000000..b9ca481f
--- /dev/null
+++ b/runtime/spu/tests/test_spu_sse_ops.c
@@ -0,0 +1,75 @@
+/* The SSE4.1 selb, rotqbyi, shlqbyi, fceq/fcgt/fcmeq/fcmgt and csflt must be
+ * bit-identical to the scalar references (spu_*_ref) for every input: random
+ * words, ordinary floats, zeros and denormals, the extended range, every
+ * shift and scale. Build on x86-64:
+ *   clang -O2 -msse4.1 -I.. -I../.. -I../../.. test_spu_sse_ops.c -o t && ./t */
+#include "../spu_helpers.h"
+#include <stdio.h>
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd32(void)
+{
+    s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17;
+    return (uint32_t)(s_rng >> 16);
+}
+static uint32_t rnd_word(void)
+{
+    const uint32_t sign = (rnd32() & 1u) << 31, man = rnd32() & 0x7FFFFFu;
+    switch (rnd32() % 8) {
+    case 0: return sign | man;                           /* exponent 0: zero / denormal */
+    case 1: return sign;                                 /* +-0 */
+    case 2: return sign | (255u << 23) | man;            /* extended range top */
+    case 3: return rnd32();
+    case 4: return rnd32() & 0xFFu;                      /* small ints (csflt) */
+    default: return sign | ((100u + rnd32() % 56) << 23) | man;
+    }
+}
+
+int main(void)
+{
+#if !defined(__SSE4_1__)
+    puts("test_spu_sse_ops: no SSE4.1, nothing to compare");
+    return 0;
+#else
+    long bad = 0;
+    const long N = 2000000;
+    for (long it = 0; it < N; it++) {
+        u128 a, b, c, got, ref;
+        for (int i = 0; i < 4; i++) { a._u32[i] = rnd_word(); b._u32[i] = rnd_word(); c._u32[i] = rnd32(); }
+        if (it % 5 == 0) b = a;                         /* equal operands for the compares */
+        const int op = (int)(it % 9), k = (int)(rnd32() & 0xFF);
+        switch (op) {
+        case 0: got = spu_selb(a, b, c);      ref = spu_selb_ref(a, b, c); break;
+        case 1: got = spu_rotqbyi(a, k);      ref = spu_rotqbyi_ref(a, k); break;
+        case 2: got = spu_shlqbyi(a, k);      ref = spu_shlqbyi_ref(a, k); break;
+        case 3: got = spu_fceq(a, b);         ref = spu_fceq_ref(a, b); break;
+        case 4: got = spu_fcgt(a, b);         ref = spu_fcgt_ref(a, b); break;
+        case 5: got = spu_fcmeq(a, b);        ref = spu_fcmeq_ref(a, b); break;
+        case 6: got = spu_fcmgt(a, b);        ref = spu_fcmgt_ref(a, b); break;
+        default: got = spu_csflt(a, k);       ref = spu_csflt_ref(a, k); break;
+        }
+        if (memcmp(&got, &ref, 16)) {
+            if (bad++ < 10)
+                printf("MISMATCH op=%d k=%d a=%08X %08X %08X %08X b=%08X %08X %08X %08X\n"
+                       "  got=%08X %08X %08X %08X ref=%08X %08X %08X %08X\n", op, k,
+                       a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], b._u32[1], b._u32[2], b._u32[3],
+                       got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+                       ref._u32[0], ref._u32[1], ref._u32[2], ref._u32[3]);
+        }
+    }
+    /* every shift amount and every csflt scale, on one fixed vector */
+    { u128 a; for (int i = 0; i < 4; i++) a._u32[i] = 0x01234567u * (uint32_t)(i + 1);
+      for (int k = -64; k < 64; k++) {
+          u128 g1 = spu_rotqbyi(a, k), r1 = spu_rotqbyi_ref(a, k);
+          u128 g2 = spu_shlqbyi(a, k), r2 = spu_shlqbyi_ref(a, k);
+          if (memcmp(&g1, &r1, 16) || memcmp(&g2, &r2, 16)) { if (bad++ < 20) printf("MISMATCH shift k=%d\n", k); }
+      }
+      for (int k = 0; k < 256; k++) {
+          u128 g = spu_csflt(a, k), r = spu_csflt_ref(a, k);
+          if (memcmp(&g, &r, 16)) { if (bad++ < 20) printf("MISMATCH csflt k=%d\n", k); }
+      } }
+    if (bad) { printf("test_spu_sse_ops: %ld mismatches\n", bad); return 1; }
+    printf("test_spu_sse_ops: ok (%ld random cases, all shifts and scales)\n", N);
+    return 0;
+#endif
+}
