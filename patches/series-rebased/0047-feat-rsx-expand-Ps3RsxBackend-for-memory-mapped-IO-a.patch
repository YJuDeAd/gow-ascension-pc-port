index 255d7636..be1ad42a 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -617,6 +617,7 @@ s32 cellGcmInit(u32 cmdSize, u32 ioSize, u32 ioAddress)
         __atomic_store_n(&s_io_mapping_hw, 1, __ATOMIC_RELAXED);
         s_io_mappings[0].active = 1;
         s_io_mapping_count = 1;
+        ps3_rsx_backend_map_io_address(0, ioAddress, ioSize);
     }
 
     /* Zero the guest-visible control register (put/get/ref). */
@@ -2036,6 +2037,7 @@ void cellGcm_fifo_kick_wait(unsigned ms)
 void cellGcm_fifo_kick(void)
 {
     if (s_gcm_kick_ev) SetEvent(s_gcm_kick_ev);
+    ps3_rsx_backend_kick_fifo(vm_read32(GCM_CONTROL_GUEST_ADDR + 0));
 }
 
 
@@ -2389,6 +2391,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
      * own command ring, so everything after the jump (including the reference
      * writes its waits spin on) silently never executed. */
     u32 put = vm_read32(GCM_CONTROL_GUEST_ADDR + 0);
+    ps3_rsx_backend_kick_fifo(put);
     /* The words behind `put` were stored by another thread (the title, or the
      * recycle below) before it stored `put`. On x86 the hardware keeps loads
      * in order; on arm64 it does not, so without an acquire here the ring
@@ -3952,6 +3955,7 @@ s32 cellGcmMapMainMemory(u32 ea, u32 size, u32* offset)
     s_io_mapping_count++;
 
     populate_offset_table(ea, io_offset, size);
+    ps3_rsx_backend_map_io_address(io_offset, ea, size);
 
     vm_write32((uint32_t)(uintptr_t)offset, io_offset);   /* guest out-param */
     return CELL_OK;
@@ -4003,6 +4007,7 @@ s32 cellGcmMapEaIoAddress(u32 ea, u32 io, u32 size)
     s_io_mapping_count++;
 
     populate_offset_table(ea, io, size);
+    ps3_rsx_backend_map_io_address(io, ea, size);
 
     return CELL_OK;
 }
@@ -4048,6 +4053,7 @@ s32 cellGcmUnmapEaIoAddress(u32 ea)
     printf("[cellGcmSys] UnmapEaIoAddress(ea=0x%08X)\n", ea);
 
     clear_offset_table(mapping->ea, mapping->io, mapping->size);
+    ps3_rsx_backend_unmap_io_address(mapping->io);
     mapping->active = 0;
     mapping->ea = 0;
     mapping->io = 0;
@@ -4070,9 +4076,16 @@ s32 cellGcmUnmapIoAddress(u32 io)
     printf("[cellGcmSys] UnmapIoAddress(io=0x%08X)\n", io);
 
     clear_offset_table(mapping->ea, mapping->io, mapping->size);
+    ps3_rsx_backend_unmap_io_address(mapping->io);
     mapping->active = 0;
+    mapping->ea = 0;
+    mapping->io = 0;
+    mapping->size = 0;
     s_io_mapping_count--;
 
+    if (s_offset_tables_published)
+        gcm_publish_offset_tables();
+
     return CELL_OK;
 }
 
