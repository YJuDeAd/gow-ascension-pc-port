From b4ed1775e3eb5d1bdcab8abbfaff8a4a12dce114 Mon Sep 17 00:00:00 2001
From: YJuDeAd <robinrashi@gmail.com>
Date: Thu, 12 Nov 2026 01:02:11 +0530
Subject: [PATCH 37/49] Apply ps3recomp-0041-dispatch-hooks-kernel-spin.patch

# Conflicts:
#	libs/spurs/cellSpurs.c
#	runtime/spu/spu_channels.c
#	runtime/spu/spu_drain.c
#	runtime/spu/spu_interp.c
---
 libs/spurs/cellSpurs.c   | 9 ++++++++-
 runtime/spu/spu_interp.c | 4 ++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
index 560a1f12..b58c5ce1 100644
--- a/libs/spurs/cellSpurs.c
+++ b/libs/spurs/cellSpurs.c
@@ -2218,6 +2218,12 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
     int disabled = getenv("PS3_NO_SPURS_PM") != NULL;
     unsigned kick_run = 0;
     AcquireSRWLockExclusive(&si->lock);
+    /* SPURS_KERNEL_SPIN=1: the kernel never sleeps between passes, it yields
+     * the CPU and looks again; workloads made ready by a plain memory write
+     * (an SPU's atomic, a PPU store) are admitted at once instead of at the
+     * next 1 ms wake. Costs a host core. */
+    static int s_spin = -1;
+    if (s_spin < 0) { const char* e = getenv("SPURS_KERNEL_SPIN"); s_spin = e && *e == '1'; }
     while (!si->stopping) {
         /* A request line committed during the last pass: look again now. Such a
          * pass serves only requested workloads and leaves pass_no alone, so the
@@ -2229,7 +2235,8 @@ static DWORD WINAPI spurs_kernel_thread(LPVOID p)
         if (__atomic_exchange_n(&si->kick, 0, __ATOMIC_ACQ_REL)) {
             kick_pass = ++kick_run < 16;
         } else {
-            SleepConditionVariableSRW(&si->wake, &si->lock, 1, 0);
+            if (s_spin) { ReleaseSRWLockExclusive(&si->lock); SwitchToThread(); AcquireSRWLockExclusive(&si->lock); }
+            else SleepConditionVariableSRW(&si->wake, &si->lock, 1, 0);
             /* This full pass reads the line after any commit that woke it. */
             (void)__atomic_exchange_n(&si->kick, 0, __ATOMIC_ACQ_REL);
         }
diff --git a/runtime/spu/spu_interp.c b/runtime/spu/spu_interp.c
index ad984b81..4f4413cd 100644
--- a/runtime/spu/spu_interp.c
+++ b/runtime/spu/spu_interp.c
@@ -576,6 +576,10 @@ uint32_t spu_interp_run_until(spu_context* ctx, uint32_t start_lsa, uint32_t sto
         /* ponytail: pc-only match; a recursive call through the same site would stop early -- compare r1 too if one shows up. */
         if (ctx->image_id >= 0 && ((stop_lsa && ctx->pc == stop_lsa) || spu_lifted_probe(ctx, ctx->pc))) { g_spu_interp_steps = steps; g_spu_interp_last_pc = ctx->pc; return ctx->pc; }  /* rejoin fast path */
         g_spu_interp_last_pc = ctx->pc;
+        /* Both watches are off unless asked for; this runs per instruction. */
+        { static int s_pw = -1;
+          if (s_pw < 0) s_pw = (getenv("SPU_PCWATCH") || getenv("SPU_ITRACE_MOD")) ? 1 : 0;
+          if (s_pw) spu_pcwatch(ctx, ctx->pc); }
         if (_g1>0) {
             int inr = (ctx->pc >= 0x26E80u && ctx->pc < 0x26F14u);
             if (inr) { _g1in = 1; }
-- 
