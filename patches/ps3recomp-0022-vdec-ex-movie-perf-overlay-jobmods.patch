+/* ---------------------------------------------------------------------------
+ * LD_PERF_OVERLAY=1: frame rate, frame time, speed, CPU and GPU use in the
+ * top-right corner of the window.
+ *
+ * The text is drawn on the CPU into a small RGBA image (a 5x7 bitmap font at
+ * twice its size) and copied into the backbuffer after the frame, so it needs
+ * no pipeline of its own and never touches the guest's surfaces.
+ *   FPS  presented frames per second (half-second window)
+ *   MS   the frame time behind it
+ *   SPD  speed against the title's native 30 frames per second
+ *   CPU  this process, as a share of the whole machine
+ *   GPU  this process's 3D engine, the counter Task Manager shows
+ *        (PDH "GPU Engine(pid_<pid>_*engtype_3D)\Utilization Percentage")
+ * ponytail: LD_PERF_OVERLAY_FPS=<n> sets the native rate SPD compares with.
+ * -------------------------------------------------------------------------*/
+#include <pdh.h>
+#pragma comment(lib, "pdh.lib")
+
+#define LD_OVL_W     136
+#define LD_OVL_H     100
+#define LD_OVL_PITCH ((LD_OVL_W * 4 + 255) & ~255)
+
+static const struct { char c; u8 rows[7]; } k_ld_glyphs[] = {
+    {'0', {0x0E,0x11,0x13,0x15,0x19,0x11,0x0E}}, {'1', {0x04,0x0C,0x04,0x04,0x04,0x04,0x0E}},
+    {'2', {0x0E,0x11,0x01,0x02,0x04,0x08,0x1F}}, {'3', {0x1F,0x02,0x04,0x02,0x01,0x11,0x0E}},
+    {'4', {0x02,0x06,0x0A,0x12,0x1F,0x02,0x02}}, {'5', {0x1F,0x10,0x1E,0x01,0x01,0x11,0x0E}},
+    {'6', {0x06,0x08,0x10,0x1E,0x11,0x11,0x0E}}, {'7', {0x1F,0x01,0x02,0x04,0x08,0x08,0x08}},
+    {'8', {0x0E,0x11,0x11,0x0E,0x11,0x11,0x0E}}, {'9', {0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C}},
+    {'F', {0x1F,0x10,0x10,0x1E,0x10,0x10,0x10}}, {'P', {0x1E,0x11,0x11,0x1E,0x10,0x10,0x10}},
+    {'S', {0x0F,0x10,0x10,0x0E,0x01,0x01,0x1E}}, {'C', {0x0E,0x11,0x10,0x10,0x10,0x11,0x0E}},
+    {'U', {0x11,0x11,0x11,0x11,0x11,0x11,0x0E}}, {'G', {0x0E,0x11,0x10,0x17,0x11,0x11,0x0F}},
+    {'D', {0x1C,0x12,0x11,0x11,0x11,0x12,0x1C}}, {'M', {0x11,0x1B,0x15,0x15,0x11,0x11,0x11}},
+    {'%', {0x18,0x19,0x02,0x04,0x08,0x13,0x03}}, {'.', {0x00,0x00,0x00,0x00,0x00,0x0C,0x0C}},
+    {'-', {0x00,0x00,0x00,0x1F,0x00,0x00,0x00}},
+};
+
+static void ld_ovl_text(u8* img, u32 x, u32 y, const char* s, u8 r, u8 gg, u8 b)
+{
+    for (; *s; s++, x += 12) {
+        const u8* rows = NULL;
+        for (u32 k = 0; k < sizeof k_ld_glyphs / sizeof k_ld_glyphs[0]; k++)
+            if (k_ld_glyphs[k].c == *s) { rows = k_ld_glyphs[k].rows; break; }
+        if (!rows) continue;                                   /* space, unknown */
+        for (u32 ry = 0; ry < 7; ry++)
+            for (u32 rx = 0; rx < 5; rx++) {
+                if (!((rows[ry] >> (4 - rx)) & 1)) continue;
+                for (u32 dy = 0; dy < 2; dy++)
+                    for (u32 dx = 0; dx < 2; dx++) {
+                        const u32 px = x + rx * 2 + dx, py = y + ry * 2 + dy;
+                        if (px >= LD_OVL_W || py >= LD_OVL_H) continue;
+                        u8* p = img + (size_t)py * LD_OVL_PITCH + px * 4;
+                        p[0] = r; p[1] = gg; p[2] = b; p[3] = 255;
+                    }
+            }
+    }
+}
+
+static void ld_perf_overlay(ID3D12Resource* bb)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_PERF_OVERLAY");
+        on = (e && e[0] && e[0] != '0') ? 1 : 0;
+    }
+    if (!on || g.width < LD_OVL_W + 16 || g.height < LD_OVL_H + 16) return;
+
+    static ID3D12Resource* up;
+    static u8* mapped;
+    if (!up) {
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        bd.Width = (UINT64)LD_OVL_PITCH * LD_OVL_H;
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        D3D12_RANGE none = {0, 0};
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&up)) ||
+            FAILED(up->lpVtbl->Map(up, 0, &none, (void**)&mapped))) {
+            fprintf(stderr, "[perf-overlay] could not create its upload buffer\n");
+            on = 0;
+            return;
+        }
+    }
+
+    /* Measurements, refreshed every half second. */
+    static LARGE_INTEGER qpf, last_t;
+    static u32 frames, cores;
+    static ULONGLONG last_cpu;
+    static double fps, ms, cpu = -1.0, gpu = -1.0, native = 30.0;
+    static PDH_HQUERY q; static PDH_HCOUNTER gpu_counter; static int pdh_state;
+    frames++;
+    LARGE_INTEGER now; QueryPerformanceCounter(&now);
+    if (!qpf.QuadPart) {
+        QueryPerformanceFrequency(&qpf);
+        last_t = now;
+        SYSTEM_INFO si; GetSystemInfo(&si); cores = si.dwNumberOfProcessors ? si.dwNumberOfProcessors : 1;
+        const char* nf = getenv("LD_PERF_OVERLAY_FPS");
+        if (nf && atof(nf) > 0) native = atof(nf);
+        FILETIME a, b, k, u;
+        GetProcessTimes(GetCurrentProcess(), &a, &b, &k, &u);
+        last_cpu = (((ULONGLONG)k.dwHighDateTime << 32) | k.dwLowDateTime) +
+                   (((ULONGLONG)u.dwHighDateTime << 32) | u.dwLowDateTime);
+        if (PdhOpenQueryW(NULL, 0, &q) == ERROR_SUCCESS) {
+            wchar_t path[160];
+            swprintf(path, 160, L"\\GPU Engine(pid_%lu_*engtype_3D)\\Utilization Percentage",
+                     (unsigned long)GetCurrentProcessId());
+            if (PdhAddEnglishCounterW(q, path, 0, &gpu_counter) == ERROR_SUCCESS &&
+                PdhCollectQueryData(q) == ERROR_SUCCESS)
+                pdh_state = 1;
+        }
+    }
+    const double dt = (double)(now.QuadPart - last_t.QuadPart) / (double)qpf.QuadPart;
+    if (dt >= 0.5) {
+        fps = frames / dt;
+        ms = frames ? dt * 1000.0 / frames : 0.0;
+        frames = 0;
+        last_t = now;
+        FILETIME a, b, k, u;
+        GetProcessTimes(GetCurrentProcess(), &a, &b, &k, &u);
+        const ULONGLONG c = (((ULONGLONG)k.dwHighDateTime << 32) | k.dwLowDateTime) +
+                            (((ULONGLONG)u.dwHighDateTime << 32) | u.dwLowDateTime);
+        cpu = (double)(c - last_cpu) / (dt * 1e7 * cores) * 100.0;   /* 100 ns units */
+        last_cpu = c;
+        if (pdh_state && PdhCollectQueryData(q) == ERROR_SUCCESS) {
+            DWORD size = 0, count = 0;
+            PdhGetFormattedCounterArrayW(gpu_counter, PDH_FMT_DOUBLE, &size, &count, NULL);
+            static PDH_FMT_COUNTERVALUE_ITEM_W* items; static DWORD items_cap;
+            if (size > items_cap) {
+                free(items); items = (PDH_FMT_COUNTERVALUE_ITEM_W*)malloc(size);
+                items_cap = items ? size : 0;
+            }
+            if (items && PdhGetFormattedCounterArrayW(gpu_counter, PDH_FMT_DOUBLE, &size,
+                                                     &count, items) == ERROR_SUCCESS) {
+                double sum = 0.0;
+                for (DWORD i = 0; i < count; i++)
+                    if (items[i].FmtValue.CStatus == ERROR_SUCCESS)
+                        sum += items[i].FmtValue.doubleValue;
+                gpu = sum > 100.0 ? 100.0 : sum;
+            }
+        }
+    }
+
+    /* Draw: a dark box, one line per figure. */
+    for (u32 y = 0; y < LD_OVL_H; y++)
+        for (u32 x = 0; x < LD_OVL_W; x++) {
+            u8* p = mapped + (size_t)y * LD_OVL_PITCH + x * 4;
+            const int edge = x == 0 || y == 0 || x == LD_OVL_W - 1 || y == LD_OVL_H - 1;
+            p[0] = p[1] = p[2] = edge ? 90 : 12; p[3] = 255;
+        }
+    char line[32];
+    const u8 fr = fps >= native * 0.95 ? 80 : fps >= native * 0.5 ? 240 : 255;
+    const u8 fg = fps >= native * 0.95 ? 255 : fps >= native * 0.5 ? 200 : 70;
+    snprintf(line, sizeof line, "FPS %5.1f", fps);                 ld_ovl_text(mapped, 8, 6, line, fr, fg, 70);
+    snprintf(line, sizeof line, "MS  %5.1f", ms);                  ld_ovl_text(mapped, 8, 24, line, 230, 230, 230);
+    snprintf(line, sizeof line, "SPD %4.0f%%", fps / native * 100.0); ld_ovl_text(mapped, 8, 42, line, 230, 230, 230);
+    if (cpu >= 0) snprintf(line, sizeof line, "CPU %4.0f%%", cpu); else snprintf(line, sizeof line, "CPU   --");
+    ld_ovl_text(mapped, 8, 60, line, 120, 200, 255);
+    if (gpu >= 0) snprintf(line, sizeof line, "GPU %4.0f%%", gpu); else snprintf(line, sizeof line, "GPU   --");
+    ld_ovl_text(mapped, 8, 78, line, 255, 160, 90);
+
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
