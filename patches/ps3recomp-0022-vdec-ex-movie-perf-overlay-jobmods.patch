+static void ld_zprobe(u32 prim, u32 n_tri, u32 zslot, const rsx_dsp_surface* sf,
+                      const rsx_dsp_viewport* vp, u32 target)
+{
+    static int armed = -1; static u32 zoff; static long from;
+    static u32 frame = ~0u; static int done = 0, read_done = 0; static u32 n = 0;
+    if (armed < 0) {
+        const char* e = getenv("LD_ZPROBE"); unsigned a = 0; long f = 0;
+        armed = e && sscanf(e, "%x,%ld", &a, &f) >= 1;
+        zoff = a; from = f;
+    }
+    if (!armed || done || !zslot || sf->zeta_offset != zoff || (long)g_ld_frames < from)
+        return;
+    if (frame == ~0u) frame = g_ld_frames;
+    if (g_ld_frames != frame) { done = 1; fprintf(stderr, "[zprobe] end of frame %u\n", frame); return; }
+    const u32 dt = rsx_dsp_reg(&g.rsx, M_DEPTH_TEST_ENABLE) & 1u;
+    const u32 dw = rsx_dsp_reg(&g.rsx, M_DEPTH_WRITE) & 1u;
+    const u32 df = rsx_dsp_reg(&g.rsx, M_DEPTH_FUNC);
+    const zdepth_t* z = &g.zdepths[zslot - 1];
+    fprintf(stderr,
+            "[zprobe] f=%u #%u surf=0x%X ct=0x%X zfmt=%u prim=%u v=%u pso=%016llx "
+            "depth{t=%u w=%u f=0x%X} zs{had_write=%u valid=%u cleared=%u} "
+            "stencil{en=%u 2s=%u f=0x%X ref=0x%X fm=0x%X wm=0x%X ops=%X/%X/%X back f=0x%X ops=%X/%X/%X} "
+            "polyoff{fill=%u scale=%g bias=%g} clip[%g,%g] zminmax=0x%X shctl=0x%X "
+            "cmask=0x%08X vpz{s=%g t=%g}\n",
+            g_ld_frames, n++, g.surfaces[target].offset, sf->color_target, sf->depth_format,
+            prim, n_tri, (unsigned long long)live_legacy_pso_key(),
+            dt, dw, df, z->had_write, z->snapshot_valid, z->cleared,
+            rsx_dsp_reg(&g.rsx, M_STENCIL_TEST_ENABLE) & 1u,
+            rsx_dsp_reg(&g.rsx, M_TWO_SIDED_STENCIL) & 1u,
+            rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC), rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF),
+            rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_MASK), rsx_dsp_reg(&g.rsx, M_STENCIL_MASK),
+            rsx_dsp_reg(&g.rsx, M_STENCIL_OP_FAIL), rsx_dsp_reg(&g.rsx, M_STENCIL_OP_ZFAIL),
+            rsx_dsp_reg(&g.rsx, M_STENCIL_OP_ZPASS), rsx_dsp_reg(&g.rsx, M_BACK_STENCIL_FUNC),
+            rsx_dsp_reg(&g.rsx, M_BACK_STENCIL_OP_FAIL), rsx_dsp_reg(&g.rsx, M_BACK_STENCIL_OP_ZFAIL),
+            rsx_dsp_reg(&g.rsx, M_BACK_STENCIL_OP_ZPASS),
+            rsx_dsp_reg(&g.rsx, 0x0A68) & 1u, ld_c2f(rsx_dsp_reg(&g.rsx, 0x0A78)),
+            ld_c2f(rsx_dsp_reg(&g.rsx, 0x0A7C)),
+            ld_c2f(rsx_dsp_reg(&g.rsx, 0x0394)), ld_c2f(rsx_dsp_reg(&g.rsx, 0x0398)),
+            rsx_dsp_reg(&g.rsx, 0x1D78), rsx_dsp_reg(&g.rsx, 0x1D60),
+            rsx_dsp_reg(&g.rsx, M_COLOR_MASK), vp->scale[2], vp->translate[2]);
+    {
+        rsx_dsp_vertex_attr a; rsx_dsp_get_vertex_attr(&g.rsx, 0, &a);
+        const u32 vbase = rsx_dsp_vertex_data_base_offset(&g.rsx);
+        const u32* c = &g.rsx.constants[264][0];
+        u64 ch = fnv1a(c, 16 * sizeof(u32), 1469598103934665603ull);
+        fprintf(stderr, "[zprobe]   attr0{type=%u size=%u stride=%u loc=%u off=0x%X} base=0x%X c264..267=%016llx",
+                a.type, a.size, a.stride, a.location, a.offset, vbase, (unsigned long long)ch);
+        for (u32 vi = 0; vi < 3; vi++) {
+            float p[4] = {0, 0, 0, 1};
+            if (!fetch_attr(0, vbase, vi, 0, p)) break;
+            float o[4];
+            for (u32 k = 0; k < 4; k++)
+                o[k] = p[0] * ld_c2f(g.rsx.constants[264][k]) + p[1] * ld_c2f(g.rsx.constants[265][k]) +
+                       p[2] * ld_c2f(g.rsx.constants[266][k]) + p[3] * ld_c2f(g.rsx.constants[267][k]);
+            const float zd = o[3] != 0.0f ? (o[2] * vp->scale[2] + o[3] * vp->translate[2]) / o[3] : 0.0f;
+            fprintf(stderr, " v%u(%g %g %g)->z=%.7f w=%g", vi, p[0], p[1], p[2], zd, o[3]);
+        }
+        /* Winding of the draw's triangles in RSX window coordinates (x right,
+         * y as the viewport maps it, origin upper-left): pos = signed area
+         * > 0, the sense RSX calls CCW. Front faces under each mapping differ
+         * by which of the two counts survives a BACK cull. */
+        if (prim == PRIM_TRIANGLES) {
+            const u32 count = dc.n_source_refs - dc.n_source_refs % 3u;
+            u32 pos = 0, neg = 0, behind = 0;
+            for (u32 t = 0; t + 2 < count; t += 3) {
+                float wx[3], wy[3]; int ok = 1;
+                for (u32 k = 0; k < 3; k++) {
+                    float fb[4];
+                    const float* p = dc_vertex_attr_canonical(topology_vertex_index(t + k), 0, fb);
+                    float o[4];
+                    for (u32 j = 0; j < 4; j++)
+                        o[j] = p[0] * ld_c2f(g.rsx.constants[264][j]) + p[1] * ld_c2f(g.rsx.constants[265][j]) +
+                               p[2] * ld_c2f(g.rsx.constants[266][j]) + p[3] * ld_c2f(g.rsx.constants[267][j]);
+                    if (o[3] <= 0.0f) { ok = 0; break; }
+                    wx[k] = o[0] / o[3] * vp->scale[0] + vp->translate[0];
+                    wy[k] = o[1] / o[3] * vp->scale[1] + vp->translate[1];
+                }
+                if (!ok) { behind++; continue; }
+                const float area = (wx[1] - wx[0]) * (wy[2] - wy[0]) - (wx[2] - wx[0]) * (wy[1] - wy[0]);
+                if (area > 0.0f) pos++; else if (area < 0.0f) neg++;
+            }
+            fprintf(stderr, "[zprobe]   winding pos=%u neg=%u behind=%u cull=%u face=0x%X front=0x%X\n",
+                    pos, neg, behind, rsx_dsp_reg(&g.rsx, M_CULL_FACE_ENABLE) & 1u,
+                    rsx_dsp_reg(&g.rsx, M_CULL_FACE), rsx_dsp_reg(&g.rsx, M_FRONT_FACE));
+        }
+        static u64 last_ch = 0;
+        if (ch != last_ch) {
+            last_ch = ch;
+            fprintf(stderr, "[zprobe]   c264..267:");
+            for (u32 r = 264; r < 268; r++)
+                fprintf(stderr, " [%g %g %g %g]", ld_c2f(g.rsx.constants[r][0]), ld_c2f(g.rsx.constants[r][1]),
+                        ld_c2f(g.rsx.constants[r][2]), ld_c2f(g.rsx.constants[r][3]));
+            fprintf(stderr, "\n");
+        }
+    }
+    if (!read_done && dt && df == 0x0202) {
+        read_done = 1;
+        ld_zprobe_readback(zslot);
+    }
+    fflush(stderr);
+}
