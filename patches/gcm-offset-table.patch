+void gcm_dump_offset_tables(const char* tag)
+{
+    fprintf(stderr, "[GCM-TABLE-DIAG] %s:\n", tag);
+    fprintf(stderr, "  GCM_OFFSET_TABLE_IO_ADDR = 0x%08X, EA_ADDR = 0x%08X\n",
+            (u32)GCM_OFFSET_TABLE_IO_ADDR, (u32)GCM_OFFSET_TABLE_EA_ADDR);
+    if (vm_base) {
+        uint32_t game_io_ptr = vm_read32(0x009BDFB4);
+        uint32_t game_ea_ptr = vm_read32(0x009BDFB8);
+        fprintf(stderr, "  Game struct @ 0x009BDFB4: ioAddress=0x%08X, eaAddress=0x%08X\n",
+                game_io_ptr, game_ea_ptr);
+    }
+    fprintf(stderr, "  Host s_io_address_table (first non-0xFFFF entries):\n");
+    int count = 0;
+    for (u32 i = 0; i < 4096 && count < 16; i++) {
+        if (s_io_address_table[i] != 0xFFFF) {
+            u16 guest_val = vm_read16(GCM_OFFSET_TABLE_IO_ADDR + i * 2);
+            fprintf(stderr, "    EA page 0x%03X (EA 0x%08X) -> IO page 0x%03X (host=0x%04X, guest=0x%04X)\n",
+                    i, i << 20, s_io_address_table[i], s_io_address_table[i], guest_val);
+            count++;
+        }
+    }
+    if (count == 0) fprintf(stderr, "    (all 0xFFFF)\n");
+
+    fprintf(stderr, "  Host s_ea_address_table (first non-0xFFFF entries):\n");
+    count = 0;
+    for (u32 i = 0; i < 4096 && count < 16; i++) {
+        if (s_ea_address_table[i] != 0xFFFF) {
+            u16 guest_val = vm_read16(GCM_OFFSET_TABLE_EA_ADDR + i * 2);
+            fprintf(stderr, "    IO page 0x%03X (IO 0x%08X) -> EA page 0x%03X (host=0x%04X, guest=0x%04X)\n",
+                    i, i << 20, s_ea_address_table[i], s_ea_address_table[i], guest_val);
+            count++;
+        }
+    }
+    if (count == 0) fprintf(stderr, "    (all 0xFFFF)\n");
+    fflush(stderr);
+}
